054688],\n  [0.34375, 0.28710938],\n  [0.31640625, 0.29296875],\n  [0.30273438, 0.30859375],\n  [0.2734375, 0.33789062],\n  [0.26757812, 0.37109375],\n  [0.27148438, 0.4140625],\n  [0.29101562, 0.43945312],\n  [0.31054688, 0.44335938],\n  [0.33984375, 0.45703125],\n  [0.37109375, 0.45898438],\n  [0.39257812, 0.45703125],\n  [0.328125, 0.48046875],\n  [0.28710938, 0.49414062],\n  [0.25585938, 0.5644531],\n  [0.23046875, 0.62890625],\n  [0.23242188, 0.6816406],\n  [0.25, 0.75],\n  [0.29882812, 0.7890625],\n  [0.3125, 0.8105469],\n  [0.30664062, 0.8457031],\n  [0.31054688, 0.8925781],\n  [0.33789062, 0.9199219],\n  [0.41796875, 0.8769531],\n  [0.44921875, 0.88671875],\n  [0.48828125, 0.9277344],\n  [0.50390625, 0.9667969],\n  [0.5332031, 0.9140625],\n  [0.5957031, 0.890625],\n  [0.6386719, 0.88671875],\n  [0.66796875, 0.9121094],\n  [0.6894531, 0.8886719],\n  [0.7050781, 0.8613281],\n  [0.6953125, 0.8183594],\n  [0.76171875, 0.75],\n  [0.765625, 0.7109375],\n  [0.765625, 0.6503906],\n  [0.7265625, 0.5605469],\n  [0.6875, 0.51953125],\n  [0.6171875, 0.49414062],\n  [0.67578125, 0.48046875],\n  [0.71484375, 0.48046875],\n  [0.73828125, 0.44726562],\n  [0.7324219, 0.39257812],\n  [0.7011719, 0.35351562],\n  [0.63671875, 0.3515625],\n  [0.57421875, 0.3515625],\n  [0.5390625, 0.38671875],\n  [0.5683594, 0.33789062],\n  [0.59765625, 0.32617188],\n  [0.6074219, 0.30664062],\n  [0.58203125, 0.26953125],\n  [0.55078125, 0.24023438],\n  [0.5390625, 0.21875],\n  [0.53515625, 0.16796875],\n  [0.5371094, 0.13671875],\n  [0.5371094, 0.095703125],\n  [0.51953125, 0.0546875],\n  [0.50390625, 0.046875],\n];\n\nconst ANIMALS = [GOOSE, FROG, BEAVER, ECHIDNA]; // 動物データを配列でまとめる\n\n// リングの色設定（RGBA形式で透明度を指定）\nconst COLORS = [\n  'rgba(255, 0, 0, 0.5)', // 赤 (透明度50%)\n  'rgba(255, 165, 0, 0.5)', // オレンジ (透明度50%)\n  'rgba(255, 255, 0, 0.5)', // 黄色 (透明度50%)\n  'rgba(173, 255, 47, 0.5)', // 黄緑 (透明度50%)\n  'rgba(0, 255, 0, 0.5)', // 緑 (透明度50%)\n  'rgba(0, 0, 255, 0.5)', // 青 (透明度50%)\n  'rgba(128, 0, 128, 0.5)' // 紫 (透明度50%)\n];\n\n// リングを管理するクラス\nclass Ring {\n  constructor(startRadius, color) {\n    this.radius = startRadius; // リングの初期半径\n    this.color = color; // リングの色\n    this.shrinkSpeed = BASE_RING_SHRINK_SPEED; // リングが縮小する速度\n  }\n\n  // リングの状態を更新する\n  update() {\n    this.radius -= this.shrinkSpeed; // 半径を縮小\n    if (this.radius < 0) {\n      // 半径が0未満になったらリングを再生成\n      this.radius = maxDiameter; // 最大半径に戻す\n    }\n  }\n\n  // リングを描画する\n  draw() {\n    noFill(); // リングは塗りつぶさない\n    stroke(this.color); // リングの色を設定\n\n    // 奥行き感を出すため、リングの太さを調整\n    const scale = map(this.radius, 0, maxDiameter, 1, BASE_RING_WIDTH); // 半径に応じた太さを計算\n    strokeWeight(scale); // リングの太さを設定\n\n    // リングをキャンバスの中心に描画\n    ellipse(width / 2, height / 2, this.radius);\n  }\n}\n\n// 動物を管理するクラス\nclass Animal {\n  constructor() {\n    this.shape = random(ANIMALS); // ランダムに動物の形状を選択\n    this.theta = random(TWO_PI); // ランダムな角度\n    this.zz = random(1, 6); // 奥行き情報（パース効果）\n    this.angleOffset = random(TWO_PI); // ランダムな回転\n    this.speed = random(0.01, 0.03); // 奥行き方向への移動速度\n  }\n\n  // 動物の位置や状態を更新する\n  update() {\n    this.zz -= this.speed; // 奥行きを減少させることで近づいているように見える\n    if (this.zz < 1) {\n      // 動物が奥行き0を超えたら再生成\n      this.theta = random(TWO_PI);\n      this.zz = random(1, 6);\n      this.angleOffset = random(TWO_PI);\n      this.speed = random(0.01, 0.03);\n      this.shape = random(ANIMALS); // 新しい動物をランダムに選択\n    }\n  }\n\n  // 動物を描画する\n  draw() {\n    push(); // 現在の描画状態を保存\n\n    // 奥行きに基づいて位置を計算\n    const r = maxDiameter / 2 + TUNNEL_RADIUS; // トンネルの半径\n    const dx = (r * cos(this.theta)) / this.zz; // X座標を計算\n    const dy = (r * sin(this.theta)) / this.zz; // Y座標を計算\n    const tx = width / 2 + dx; // キャンバス中心基準のX位置\n    const ty = height / 2 + dy; // キャンバス中心基準のY位置\n\n    // スケールを奥行きに基づいて計算\n    const tunneldist = sqrt(dx * dx + dy * dy); // トンネル中心からの距離\n    const persp = (tunneldist - TUNNEL_RADIUS + 5) / (maxDiameter / 2);\n\n    // 動物の変形を設定\n    translate(tx, ty); // 動物を位置に移動\n    rotate(atan2(dy, dx)); // 動物を中心方向に向ける\n    scale(\n      min(1.0, pow(persp, 3) * 2),\n      min(1.0, persp)\n    ); // パース効果に基づいてスケール変更\n    rotate(this.angleOffset); // ランダム回転\n\n    fill(255, 125); // 動物の塗り色（半透明の白）\n    stroke(255); // 動物の輪郭の色（白）\n    strokeWeight(1); // 動物の輪郭の太さ\n\n    // 動物の形状を描画\n    beginShape();\n    this.shape.forEach(([px, py]) => {\n      vertex(\n        BASE_ANIMAL_SCALE * (px - 0.5), // X座標\n        BASE_ANIMAL_SCALE * (py - 0.5) // Y座標\n      );\n    });\n    endShape(CLOSE);\n\n    pop(); // 描画状態を元に戻す\n  }\n}\n\n// 初期設定\nfunction setup() {\n  createCanvas(windowWidth, windowHeight); // キャンバスをウィンドウサイズに設定\n  adjustScaling(); // スケール調整\n  maxDiameter = sqrt(sq(width) + sq(height)); // キャンバスの対角線の長さを計算\n\n  // リングを初期化\n  for (let i = 0; i < RING_COUNT; i++) {\n    const startRadius = maxDiameter - (i * (maxDiameter / RING_COUNT)); // リングの開始半径を計算\n    const color = COLORS[i % COLORS.length]; // リングの色を設定\n    ringObjects.push(new Ring(startRadius, color)); // リングオブジェクトを生成\n  }\n\n  // 動物を初期化\n  for (let i = 0; i < ANIMAL_COUNT; i++) {\n    animals.push(new Animal()); // 動物オブジェクトを生成\n  }\n}\n\n// 描画ループ\nfunction draw() {\n  background(0, 20); // 背景を黒に設定し、透明度で軌跡を残す\n\n  // リングをすべて描画\n  ringObjects.forEach((ring) => {\n    ring.update();\n    ring.draw();\n  });\n\n  // 動物をすべて描画（リングより上に配置される）\n  animals.forEach((animal) => {\n    animal.update();\n    animal.draw();\n  });\n}\n\n// ウィンドウサイズが変更されたときの処理\nfunction windowResized() {\n  resizeCanvas(windowWidth, windowHeight); // キャンバスを再設定\n  adjustScaling(); // スケールを再調整\n  maxDiameter = sqrt(sq(width) + sq(height)); // 最大直径を再計算\n\n  // リングを再初期化\n  ringObjects = [];\n  for (let i = 0; i < RING_COUNT; i++) {\n    var startRadius = maxDiameter - (i * (maxDiameter / RING_COUNT));\n    var color = COLORS[i % COLORS.length];\n    ringObjects.push(new Ring(startRadius, color));\n  }\n}\n\n// スケール調整\nfunction adjustScaling() {\n  const scaleFactor = max(width, height) / BASE_CANVAS_SIZE;\n  BASE_ANIMAL_SCALE = 120.0 * scaleFactor;\n  BASE_RING_WIDTH = 40 * scaleFactor;\n  BASE_RING_SHRINK_SPEED = 1 * scaleFactor;\n}",
