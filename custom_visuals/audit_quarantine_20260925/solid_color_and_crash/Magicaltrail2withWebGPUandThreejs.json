{
    "name": "Magicaltrail2withWebGPUandThreejs",
    "code": "",
    "frequency": 50,
    "storyboard_weight": 50,
    "post_fx_intensity": 50,
    "custom_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Magical Trail Shader 2 — WebGPU</title>\n\n    <script async src=\"https://unpkg.com/es-module-shims@1.8.3/dist/es-module-shims.js\"></script>\n    <script type=\"importmap\">\n        {\n            \"imports\": {\n                \"three\": \"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\"\n            }\n        }\n    </script>\n\n    <style>\n        html,\n        body {\n            width: 100%;\n            height: 100%;\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n            background: #000;\n            cursor: none;\n            touch-action: none;\n            overscroll-behavior: none;\n            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n        }\n\n        canvas {\n            position: fixed;\n            inset: 0;\n            width: 100vw;\n            height: 100vh;\n            display: block;\n            background: #000;\n            cursor: none;\n            touch-action: none;\n        }\n\n        #runtime-badge {\n            position: fixed;\n            left: 14px;\n            bottom: 12px;\n            z-index: 5;\n            color: rgba(190, 235, 255, 0.68);\n            background: rgba(0, 9, 18, 0.28);\n            border: 1px solid rgba(85, 220, 255, 0.16);\n            border-radius: 999px;\n            padding: 7px 10px;\n            font-size: 11px;\n            letter-spacing: 0.02em;\n            pointer-events: none;\n            user-select: none;\n            opacity: 1;\n            transition: opacity 900ms ease;\n            backdrop-filter: blur(12px);\n        }\n\n        #error-badge {\n            position: fixed;\n            left: 14px;\n            right: 14px;\n            top: 14px;\n            z-index: 6;\n            display: none;\n            color: rgba(255, 220, 220, 0.95);\n            background: rgba(30, 0, 0, 0.74);\n            border: 1px solid rgba(255, 90, 90, 0.35);\n            border-radius: 12px;\n            padding: 11px 12px;\n            font-size: 12px;\n            line-height: 1.45;\n            white-space: pre-wrap;\n            pointer-events: none;\n            user-select: none;\n            backdrop-filter: blur(12px);\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"stage\" aria-label=\"Magical trail shader canvas\"></canvas>\n    \n    <div id=\"error-badge\"></div>\n\n    <script type=\"module\">\n        import * as THREE from \"three\";\n\n        const canvas = document.getElementById(\"stage\");\n        const runtimeBadge = document.getElementById(\"runtime-badge\");\n        const errorBadge = document.getElementById(\"error-badge\");\n\n        const MAX_TRAIL_COUNT = 30;\n        const MAX_PARTICLES = 8192;\n        const MAX_INSTANCES = MAX_PARTICLES + MAX_TRAIL_COUNT + 16;\n        const DEG_TO_RAD = Math.PI / 180;\n        const FRAME_MS = 1000 / 60;\n\n        const colorScheme = [\"#0A1B28\", \"#071F43\", \"#357D7E\", \"#35EEEE\", \"#919DF0\"];\n        const colorSchemeRgb = colorScheme.map(hexToRgb01);\n        const blueTrailColor = hexToRgb01(\"#007DFF\");\n        const cyanCursorColor = hexToRgb01(\"#35EEEE\");\n\n        let viewWidth = Math.max(1, window.innerWidth);\n        let viewHeight = Math.max(1, window.innerHeight);\n        let devicePixelRatioCapped = Math.min(Math.max(window.devicePixelRatio || 1, 1), 2);\n\n        let pointerX = viewWidth * 0.5;\n        let pointerY = viewHeight * 0.5;\n        let previousPointerX = pointerX;\n        let previousPointerY = pointerY;\n        let hasPointer = false;\n        let middleMouseDown = false;\n        let lastFrameTime = performance.now();\n        let runtimeSeconds = 0;\n\n        const trailX = [];\n        const trailY = [];\n\n        const particleX = new Float32Array(MAX_PARTICLES);\n        const particleY = new Float32Array(MAX_PARTICLES);\n        const particleVelocityX = new Float32Array(MAX_PARTICLES);\n        const particleVelocityY = new Float32Array(MAX_PARTICLES);\n        const particleMass = new Float32Array(MAX_PARTICLES);\n        const particleDrag = new Float32Array(MAX_PARTICLES);\n        const particleLife = new Float32Array(MAX_PARTICLES);\n        const particleLifeStep = new Float32Array(MAX_PARTICLES);\n        const particleColorIndex = new Uint8Array(MAX_PARTICLES);\n        let particleCount = 0;\n\n      \n        const instanceParamData = new Float32Array(MAX_INSTANCES * 2);\n        const instanceTintData = new Float32Array(MAX_INSTANCES * 3);\n        const instanceMatrices = new Float32Array(MAX_INSTANCES * 16);\n\n        let renderer = null;\n        let scene = null;\n        let camera = null;\n        let glowMesh = null;\n        let glowMaterial = null;\n        let instanceParamAttribute = null;\n        let instanceTintAttribute = null;\n        let animationHandle = 0;\n\n        const matrixScratch = new THREE.Matrix4();\n\n        function hexToRgb01(hex) {\n            const clean = hex.replace(\"#\", \"\");\n            const value = parseInt(clean, 16);\n            return [\n                ((value >> 16) & 255) / 255,\n                ((value >> 8) & 255) / 255,\n                (value & 255) / 255\n            ];\n        }\n\n        function randomBetween(minimum, maximum) {\n            return minimum + Math.random() * (maximum - minimum);\n        }\n\n        function randomInteger(maximumExclusive) {\n            return Math.floor(Math.random() * maximumExclusive);\n        }\n\n        function clamp(value, minimum, maximum) {\n            return Math.max(minimum, Math.min(maximum, value));\n        }\n\n        function showError(error) {\n            const message = error && error.stack ? error.stack : String(error);\n            errorBadge.style.display = \"block\";\n            errorBadge.textContent = `Three.js renderer error:\\n${message}`;\n            runtimeBadge.textContent = \"renderer error\";\n            runtimeBadge.style.opacity = \"1\";\n            console.error(error);\n        }\n\n        function installPointerControls() {\n            window.addEventListener(\"pointermove\", (event) => {\n                pointerX = event.clientX;\n                pointerY = event.clientY;\n                hasPointer = true;\n            }, { passive: true });\n\n            window.addEventListener(\"pointerdown\", (event) => {\n                hasPointer = true;\n                pointerX = event.clientX;\n                pointerY = event.clientY;\n\n                if (event.button === 1) {\n                    middleMouseDown = true;\n                    event.preventDefault();\n                }\n            }, { passive: false });\n\n            window.addEventListener(\"pointerup\", (event) => {\n                if (event.button === 1) {\n                    middleMouseDown = false;\n                    event.preventDefault();\n                }\n            }, { passive: false });\n\n            window.addEventListener(\"pointercancel\", () => {\n                middleMouseDown = false;\n            }, { passive: true });\n\n            window.addEventListener(\"blur\", () => {\n                middleMouseDown = false;\n            }, { passive: true });\n\n            window.addEventListener(\"contextmenu\", (event) => {\n                event.preventDefault();\n            }, { passive: false });\n\n            window.addEventListener(\"auxclick\", (event) => {\n                if (event.button === 1) {\n                    event.preventDefault();\n                }\n            }, { passive: false });\n\n            window.addEventListener(\"resize\", () => {\n                resizeRenderer();\n            }, { passive: true });\n        }\n\n        function pushTrailPoint() {\n            trailX.push(pointerX);\n            trailY.push(pointerY);\n\n            const removeCount = middleMouseDown ? 4 : 1;\n\n            for (let index = 0; index < removeCount; index++) {\n                if (trailX.length === 0) {\n                    break;\n                }\n\n                if (middleMouseDown || trailX.length > MAX_TRAIL_COUNT) {\n                    trailX.shift();\n                    trailY.shift();\n                }\n            }\n        }\n\n        function spawnParticle(x, y, directionX, directionY, movementDistance) {\n            if (particleCount >= MAX_PARTICLES) {\n                removeParticle(0);\n            }\n\n            const index = particleCount;\n            particleCount += 1;\n\n            const spreadAngle = randomBetween(-25, 25) * DEG_TO_RAD;\n            const angleCos = Math.cos(spreadAngle);\n            const angleSin = Math.sin(spreadAngle);\n            const rotatedX = directionX * angleCos - directionY * angleSin;\n            const rotatedY = directionX * angleSin + directionY * angleCos;\n            const movementBoost = clamp(movementDistance / 44, 0.65, 1.8);\n            const velocityMagnitude = Math.random() * 10 * movementBoost;\n\n            particleX[index] = x;\n            particleY[index] = y;\n            particleVelocityX[index] = rotatedX * velocityMagnitude;\n            particleVelocityY[index] = rotatedY * velocityMagnitude;\n            particleMass[index] = randomBetween(1, 30);\n            particleDrag[index] = randomBetween(0.92, 0.98);\n            particleColorIndex[index] = randomInteger(colorSchemeRgb.length);\n            particleLife[index] = 0;\n            particleLifeStep[index] = randomBetween(-1, 1);\n        }\n\n        function removeParticle(index) {\n            const lastIndex = particleCount - 1;\n\n            if (index !== lastIndex) {\n                particleX[index] = particleX[lastIndex];\n                particleY[index] = particleY[lastIndex];\n                particleVelocityX[index] = particleVelocityX[lastIndex];\n                particleVelocityY[index] = particleVelocityY[lastIndex];\n                particleMass[index] = particleMass[lastIndex];\n                particleDrag[index] = particleDrag[lastIndex];\n                particleColorIndex[index] = particleColorIndex[lastIndex];\n                particleLife[index] = particleLife[lastIndex];\n                particleLifeStep[index] = particleLifeStep[lastIndex];\n            }\n\n            particleCount = Math.max(0, particleCount - 1);\n        }\n\n        function spawnParticlesFromPointerMovement() {\n            const movementX = pointerX - previousPointerX;\n            const movementY = pointerY - previousPointerY;\n            const movementDistance = Math.hypot(movementX, movementY);\n\n            if (trailX.length > 1 && movementDistance > 5) {\n                const directionX = movementX / movementDistance;\n                const directionY = movementY / movementDistance;\n                const spawnCount = clamp(Math.floor(movementDistance / 13), 3, 10);\n\n                for (let index = 0; index < spawnCount; index++) {\n                    const along = spawnCount === 1 ? 0 : index / (spawnCount - 1);\n                    const jitterX = randomBetween(-1.5, 1.5);\n                    const jitterY = randomBetween(-1.5, 1.5);\n                    const spawnX = previousPointerX + movementX * along + jitterX;\n                    const spawnY = previousPointerY + movementY * along + jitterY;\n                    spawnParticle(spawnX, spawnY, directionX, directionY, movementDistance);\n                }\n            }\n\n            previousPointerX = pointerX;\n            previousPointerY = pointerY;\n        }\n\n        function updateParticles(stepScale) {\n            const removalMargin = 480;\n            const fadeDrag = middleMouseDown ? Math.pow(0.82, stepScale) : 1;\n            const speedKillThreshold = middleMouseDown ? 0.42 : 0.1;\n\n            for (let index = particleCount - 1; index >= 0; index--) {\n                const rotationAngle = particleLife[index] * 0.002 * DEG_TO_RAD;\n                const rotationCos = Math.cos(rotationAngle);\n                const rotationSin = Math.sin(rotationAngle);\n                const oldX = particleX[index];\n                const oldY = particleY[index];\n\n                particleX[index] = oldX * rotationCos - oldY * rotationSin;\n                particleY[index] = oldX * rotationSin + oldY * rotationCos;\n\n                const drag = Math.pow(particleDrag[index], stepScale) * fadeDrag;\n                particleVelocityX[index] *= drag;\n                particleVelocityY[index] *= drag;\n                particleX[index] += particleVelocityX[index] * stepScale;\n                particleY[index] += particleVelocityY[index] * stepScale;\n                particleLife[index] += particleLifeStep[index] * stepScale;\n\n                const speed = Math.hypot(particleVelocityX[index], particleVelocityY[index]);\n                const outsideBounds =\n                    particleX[index] < -removalMargin ||\n                    particleX[index] > viewWidth + removalMargin ||\n                    particleY[index] < -removalMargin ||\n                    particleY[index] > viewHeight + removalMargin;\n\n                if (speed < speedKillThreshold || outsideBounds) {\n                    removeParticle(index);\n                }\n            }\n        }\n\n        function updateSimulation(deltaMs) {\n            const stepScale = clamp(deltaMs / FRAME_MS, 0.25, 2.5);\n            pushTrailPoint();\n            spawnParticlesFromPointerMovement();\n            updateParticles(stepScale);\n        }\n\n        \n        function writeInstanceMatrix(instanceIndex, x, y, radius) {\n            const translateX = x - viewWidth * 0.5;\n            const translateY = viewHeight * 0.5 - y;\n\n            matrixScratch.set(\n                radius, 0, 0, translateX,\n                0, radius, 0, translateY,\n                0, 0, 1, 0,\n                0, 0, 0, 1\n            );\n\n            matrixScratch.toArray(instanceMatrices, instanceIndex * 16);\n        }\n\n        \n        function addInstance(instanceIndex, x, y, radius, intensity, tint, core) {\n            if (instanceIndex >= MAX_INSTANCES) {\n                return instanceIndex;\n            }\n\n            const paramOffset = instanceIndex * 2;\n            const tintOffset = instanceIndex * 3;\n\n            writeInstanceMatrix(instanceIndex, x, y, radius);\n\n            instanceParamData[paramOffset] = intensity;\n            instanceParamData[paramOffset + 1] = core;\n\n            instanceTintData[tintOffset] = tint[0];\n            instanceTintData[tintOffset + 1] = tint[1];\n            instanceTintData[tintOffset + 2] = tint[2];\n\n            return instanceIndex + 1;\n        }\n\n        function buildInstances() {\n            let instanceIndex = 0;\n            const trailLength = trailX.length;\n\n            for (let index = 0; index < trailLength; index++) {\n                const normalized = trailLength <= 1 ? 1 : index / (trailLength - 1);\n                const mass = index * 1.5;\n                const radius = 7 + mass * 1.35 + normalized * 5;\n                const intensity = 0.05 + normalized * 0.22;\n\n                instanceIndex = addInstance(\n                    instanceIndex,\n                    trailX[index],\n                    trailY[index],\n                    radius,\n                    intensity,\n                    blueTrailColor,\n                    0.025 + normalized * 0.035\n                );\n            }\n\n          \n            const cursorPulse = 0.5 + 0.5 * Math.sin(runtimeSeconds * 9.0);\n\n            instanceIndex = addInstance(\n                instanceIndex,\n                pointerX,\n                pointerY,\n                34 + cursorPulse * 4.5,\n                0.22,\n                cyanCursorColor,\n                0.05\n            );\n\n            instanceIndex = addInstance(\n                instanceIndex,\n                pointerX,\n                pointerY,\n                52 + cursorPulse * 6.5,\n                0.11,\n                cyanCursorColor,\n                0.015\n            );\n\n            for (let index = 0; index < particleCount; index++) {\n                const speed = Math.hypot(particleVelocityX[index], particleVelocityY[index]);\n                const mass = particleMass[index] * speed * 0.6;\n                const radius = clamp(2.0 + mass * 1.25, 1.6, 58);\n                const intensity = clamp(0.10 + speed * 0.032 + particleMass[index] * 0.0025, 0.08, 0.72);\n                const core = clamp(0.045 + speed * 0.007, 0.04, 0.20);\n                const tint = colorSchemeRgb[particleColorIndex[index]];\n\n                instanceIndex = addInstance(\n                    instanceIndex,\n                    particleX[index],\n                    particleY[index],\n                    radius,\n                    intensity,\n                    tint,\n                    core\n                );\n            }\n\n            return instanceIndex;\n        }\n\n        function createGlowMaterial() {\n           \n            return new THREE.ShaderMaterial({\n                transparent: true,\n                depthTest: false,\n                depthWrite: false,\n                blending: THREE.AdditiveBlending,\n                uniforms: {\n                    uTime: {\n                        value: 0\n                    },\n                    uExposure: {\n                        value: 1.16\n                    }\n                },\n                vertexShader: `\n                    precision highp float;\n\n                    attribute vec2 instanceParams;\n                    attribute vec3 instanceTint;\n\n                    varying vec2 vLocal;\n                    varying vec3 vTint;\n                    varying float vIntensity;\n                    varying float vCore;\n                    varying vec2 vCenter;\n\n                    void main() {\n                        vLocal = position.xy;\n                        vTint = instanceTint;\n                        vIntensity = instanceParams.x;\n                        vCore = instanceParams.y;\n\n                        vec4 centered = instanceMatrix * vec4(position, 1.0);\n                        vec4 worldPosition = modelMatrix * centered;\n                        vec4 centerPosition = modelMatrix * instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);\n\n                        vCenter = centerPosition.xy;\n\n                        gl_Position = projectionMatrix * viewMatrix * worldPosition;\n                    }\n                `,\n                fragmentShader: `\n                    precision highp float;\n\n                    uniform float uTime;\n                    uniform float uExposure;\n\n                    varying vec2 vLocal;\n                    varying vec3 vTint;\n                    varying float vIntensity;\n                    varying float vCore;\n                    varying vec2 vCenter;\n\n                    void main() {\n                        float squaredDistance = dot(vLocal, vLocal);\n\n                        if (squaredDistance > 1.0) {\n                            discard;\n                        }\n\n                        float distanceFromCenter = sqrt(max(squaredDistance, 0.000001));\n                        float envelope = max(1.0 - distanceFromCenter, 0.0);\n                        float slowSparkle = 0.94 + 0.06 * sin(uTime * 6.0 + vCenter.x * 0.013 + vCenter.y * 0.017);\n                        float energy = vIntensity * slowSparkle;\n\n                        float broadHalo = exp(-squaredDistance * 2.25);\n                        float smokeGlow = exp(-squaredDistance * 5.5);\n                        float innerGlow = exp(-squaredDistance * 21.0);\n                        float hotNeedle = exp(-squaredDistance * 185.0) * vCore;\n                        float electricEdge = pow(envelope, 4.8) * 0.18;\n\n                        vec3 coloredBloom = vTint * energy * (broadHalo * 0.62 + smokeGlow * 0.42 + innerGlow * 0.35);\n                        vec3 spectralLift = vec3(0.10, 0.84, 1.0) * energy * electricEdge;\n                        vec3 whiteCore = vec3(1.0) * energy * hotNeedle * 3.15;\n                        vec3 finalColor = (coloredBloom + spectralLift + whiteCore) * uExposure;\n\n                        gl_FragColor = vec4(finalColor, 1.0);\n                    }\n                `\n            });\n        }\n\n        function createThreeRenderer() {\n            renderer = new THREE.WebGLRenderer({\n                canvas,\n                antialias: false,\n                alpha: false,\n                powerPreference: \"high-performance\",\n                preserveDrawingBuffer: false\n            });\n\n            renderer.debug.checkShaderErrors = true;\n            renderer.setClearColor(0x000000, 1);\n            renderer.setPixelRatio(devicePixelRatioCapped);\n            renderer.setSize(viewWidth, viewHeight, false);\n            renderer.autoClear = true;\n\n            scene = new THREE.Scene();\n\n            camera = new THREE.OrthographicCamera(\n                viewWidth * -0.5,\n                viewWidth * 0.5,\n                viewHeight * 0.5,\n                viewHeight * -0.5,\n                -10,\n                10\n            );\n            camera.position.z = 1;\n            camera.updateProjectionMatrix();\n\n           \n            const glowGeometry = new THREE.PlaneGeometry(2, 2, 1, 1);\n\n            \n            instanceParamAttribute = new THREE.InstancedBufferAttribute(instanceParamData, 2);\n            instanceTintAttribute = new THREE.InstancedBufferAttribute(instanceTintData, 3);\n\n            instanceParamAttribute.setUsage(THREE.DynamicDrawUsage);\n            instanceTintAttribute.setUsage(THREE.DynamicDrawUsage);\n\n            glowGeometry.setAttribute(\"instanceParams\", instanceParamAttribute);\n            glowGeometry.setAttribute(\"instanceTint\", instanceTintAttribute);\n\n            glowMaterial = createGlowMaterial();\n\n            glowMesh = new THREE.InstancedMesh(glowGeometry, glowMaterial, MAX_INSTANCES);\n            glowMesh.frustumCulled = false;\n            glowMesh.count = 0;\n            glowMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n\n            scene.add(glowMesh);\n        }\n\n        function resizeRenderer() {\n            viewWidth = Math.max(1, window.innerWidth);\n            viewHeight = Math.max(1, window.innerHeight);\n            devicePixelRatioCapped = Math.min(Math.max(window.devicePixelRatio || 1, 1), 2);\n\n            if (!hasPointer) {\n                pointerX = viewWidth * 0.5;\n                pointerY = viewHeight * 0.5;\n                previousPointerX = pointerX;\n                previousPointerY = pointerY;\n            }\n\n            if (renderer) {\n                renderer.setPixelRatio(devicePixelRatioCapped);\n                renderer.setSize(viewWidth, viewHeight, false);\n            }\n\n            if (camera) {\n                camera.left = viewWidth * -0.5;\n                camera.right = viewWidth * 0.5;\n                camera.top = viewHeight * 0.5;\n                camera.bottom = viewHeight * -0.5;\n                camera.updateProjectionMatrix();\n            }\n        }\n\n      \n        function uploadInstances(instanceCount) {\n            if (!glowMesh) {\n                return;\n            }\n\n            glowMesh.count = instanceCount;\n\n            glowMesh.instanceMatrix.array.set(instanceMatrices.subarray(0, instanceCount * 16), 0);\n            glowMesh.instanceMatrix.needsUpdate = true;\n\n            instanceParamAttribute.needsUpdate = true;\n            instanceTintAttribute.needsUpdate = true;\n        }\n\n        function renderFrame(now) {\n            try {\n                const deltaMs = Math.min(64, Math.max(1, now - lastFrameTime));\n                lastFrameTime = now;\n                runtimeSeconds += deltaMs / 1000;\n\n                updateSimulation(deltaMs);\n\n                const instanceCount = buildInstances();\n                uploadInstances(instanceCount);\n\n                glowMaterial.uniforms.uTime.value = runtimeSeconds;\n\n                renderer.render(scene, camera);\n                animationHandle = requestAnimationFrame(renderFrame);\n            } catch (error) {\n                cancelAnimationFrame(animationHandle);\n                showError(error);\n            }\n        }\n\n        function start() {\n            try {\n                createThreeRenderer();\n                resizeRenderer();\n                installPointerControls();\n\n              \n\n                lastFrameTime = performance.now();\n                animationHandle = requestAnimationFrame(renderFrame);\n            } catch (error) {\n                showError(error);\n            }\n        }\n\n        start();\n    </script>\n</body>\n</html>\n",
    "custom_css": "\n/* === 4K MV Pure Canvas - 全域控制項與 UI 面板隱藏 === */\n.dg, .lil-gui, .qs_main, .opc-control, #opc-control-panel, .control-panel, .gui-container,\n[class*='gui'], [id*='gui'], [class*='control'], [id*='control'],\n[class*='instruction'], [id*='instruction'], [class*='info'], [id*='info'],\n[class*='fps'], [id*='fps'], [class*='overlay'], [id*='overlay'],\ninput, button, select, textarea, label, form {\n  display: none !important;\n  visibility: hidden !important;\n  opacity: 0 !important;\n  pointer-events: none !important;\n}\n",
