		var defaultLibraries = [{"libraryID":1,"title":"p5.dom","version":"0.2.11","for":2,"forVersion":"","highlight":null,"description":"(p5.dom is now part of p5js, no need to enable if using v0.10+).<br\/>p5.dom library lets you use video, audio, webcam, input, and text.<br\/>\nExamples: <a target=\"_blank\" href=\"https:\/\/www.openprocessing.org\/sketch\/565368\">Dom<\/a> - <a target=\"_blank\" href=\"https:\/\/www.openprocessing.org\/sketch\/565603\">Video<\/a> ","category":"UI Helpers","url":"https:\/\/www.openprocessing.org\/assets\/js\/vendor\/p5jsReleases\/p5-release-0.5.2\/addons\/p5.dom.js","docUrl":"http:\/\/p5js.org\/reference\/#\/libraries\/p5.dom","releaseUrl":""},{"libraryID":2,"title":"p5.sound","version":"0.3.0","for":2,"forVersion":"","highlight":null,"description":"p5.sound extends p5 with Web Audio functionality including audio input, playback, analysis and synthesis.<br\/>Examples: <a href=\"https:\/\/www.openprocessing.org\/sketch\/565585\" target=\"_blank\">Play<\/a> -  <a href=\"https:\/\/www.openprocessing.org\/sketch\/565638\" target=\"_blank\">Synthesis<\/a> - <a href=\"https:\/\/www.openprocessing.org\/sketch\/566618\" target=\"_blank\">Microphone<\/a>","category":"Audio","url":"https:\/\/www.openprocessing.org\/assets\/js\/vendor\/p5jsReleases\/p5-release-0.5.2\/addons\/p5.sound.js","docUrl":"http:\/\/p5js.org\/reference\/#\/libraries\/p5.sound","releaseUrl":null},{"libraryID":3,"title":"p5.collide2d","version":"0.1","for":2,"forVersion":"","highlight":null,"description":"This library allows easy collision detection for variety of shapes, which lets you detect when shapes overlap on canvas.<br\/>\n<a href=\"https:\/\/www.openprocessing.org\/sketch\/565396\" target=\"_blank\">Example<\/a>","category":"Physics & Game Mechanics","url":"https:\/\/cdn.jsdelivr.net\/gh\/bmoren\/p5.collide2D@0.1\/p5.collide.js","docUrl":"https:\/\/github.com\/bmoren\/p5.collide2D","releaseUrl":"https:\/\/api.github.com\/repos\/bmoren\/p5.collide2D\/releases"},{"li