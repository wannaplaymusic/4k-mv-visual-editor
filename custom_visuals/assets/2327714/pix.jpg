<body class="loading">
	<div id="app" :class="{ [app.currentMode]: true, [app.layout]: true, 'fullscreen': app.isFullscreen, 'recordMode': app.recordMode,'showInstructions': app.showInstructions, 'commentsDisabled': !sessionUser.canComment, 'sourceHidden': +sketch.sourceHidden, 'darkMode': app.darkMode,'tutorial': sketch.isTutorial, 'showCodeOptions': app.showCodeOptions, 'fade':1, 'in': app.currentMode, 'dirty': sketch.isDirty, 'ligaturesEnabled': app.ligaturesEnabled, 'demo': app.demo }">
		<confetti v-if="app.throwConfetti" :particle-count="250" :spread="180" :origin="{ y: 0.6 }" :disable-for-reduced-motion="app.disableForReducedMotion" :auto-start="true"></confetti>
		<div v-if="+user.active < 1" class="warningBox" style="width: 30%; margin-top: 50px; position: fixed; z-index: 1000;" v-cloak>
			<div>{{$t('user.suspension_warning')}}</div>
		</div>
		<div class="navbar navbar-fixed-top " role="navigation" v-cloak>
			<div class="iconsRow" @click.capture="exitInfoModeFromNavbar">
				<snow-effect></snow-effect>
				<div id="websiteControls">
					<div id="websiteControlsInner" class="pointer" @click="app.currentMode == 'infoMode' ? app.currentMode = app.previousMode : app.currentMode = 'infoMode'">
						<a class="OPlogo" href="/" @click.stop="null"><img src="/assets/img/logo/logo_36x30_white@2x.png"></a>
						<div class="sketchInfo noLang" v-if="!sketch.newSketch" v-cloak>
							<div class="sketchTitle" name="sketchInfoToggle">
								<span class="sketchTitleText">
									<span v-if="+sketch.active < 1">🏴‍☠️</span>
									{{sketch.title}}
								</span>
								<span class="sketchInfoCaret"></span>
							</div>
							<sketch-author
								:user="user"
								profile-url="/@bourneidentity/#sketches"
								:show-author="!sessionUser.isOwner"
								:can-follow="false"></sketch-author>
						</div>
					</div>
				</div>
				<sketch-controls v-model="app.currentMode" :tutorial="sketch.isTutorial" :split="app.layout === 'layout_split'" :mobile="app.isMobile" :restart-seed="playModeIconReplayKey" @restart="playSketch()" v-cloak></sketch-controls>
				<!-- <button type="button" class="icon icon_burger navbar-toggle collapsed visible-xs" data-toggle="collapse" data-target="#sideControls" aria-expanded="false"></button> -->
				<div id="sideWrapper">
					<div id="sideControls" v-if="!sketch.newSketch && !app.isEmbedPage" v-show="!app.isMobile || !(sketch.isDirty || app.justSaved)">
						<div v-show="app.speakerState" class="metricGroup hidden-xs">
							<div id="OP_speaker" :class="{'icon pointer':1, [app.speakerState]:1}" @click="toggleSound()"></div>
						</div>
						<div v-if="!app.liveCodeEnabled && sessionUser.canInteractWith" :class="{'metricGroup':1,'selected': app.sidePanel == 'hearts'}">
							<div class="icon icon_heart pointer" :class="sketch.hearts.find(u=>u.userID == sessionUser.userID) ? 'selected':''"></div>
							<div class="icon icon_arrowToHeart" :class="sketch.hearts.find(u=>u.userID == sessionUser.userID) ? 'shoot':''"></div>
							<div class="metric" data-target="hearts" @click="toggleSidePanel('hearts')">
								{{sketch.hearts.length}}
							</div>
						</div>
						<div v-if="!app.liveCodeEnabled && sessionUser.canInteractWith" :class="{'metricGroup':1,'selected': app.sidePanel == 'comments'}" @click="toggleSidePanel('comments')">
							<div class="icon icon_comment pointer" @click.stop="toggleFocusOnCommentBox"></div>
							<div class="metric" data-target="comments">
								{{commentsTotal}}
							</div>
						</div>

						<div v-if="!app.liveCodeEnabled" :class="{'metricGroup hidden-xs':1,'selected': app.sidePanel == 'forks'}" @click="toggleSidePanel('forks')">
							<div class="icon icon_fork_white pointer" data-target="forks"></div>
							<div id="forkCount" class="metric" data-target="forks">{{sketch.forkCount ?? ''}}</div>
						</div>

						<div v-if="!app.liveCodeEnabled" :class="{'metricGroup hidden-xs':1,'selected': app.sidePanel == 'share'}" @click="toggleSidePanel('share')">
							<div class="icon icon_share white pointer" data-target="share"></div>
							<div class="metric hide" data-target="share">
							</div>
						</div>

					</div>
					<op-livecodelist id="liveCodeStatus" :list="app.liveCodeUsers" v-show="app.liveCodeUsers && (app.currentMode == 'playMode' || app.currentMode == 'codeMode')" :limit="7"></op-livecodelist>
					<div id="navigationProfile" v-if="!app.isEmbedPage" class="hidden-xs" name="navbar-profile-dropdown">
						<op-user class="nav-link" :user="sessionUser" :link="false" id="navbar-profile-thumb" width="30" height="30"></op-user>
						<op-navbar-dropdown v-if="sessionUser.userID > 0" :user="sessionUser"></op-navbar-dropdown>
						<op-navbar-dropdown-guest v-else></op-navbar-dropdown-guest>
					</div>
					<div id="infoPanelButtons">
						<!-- Edit Sketch Button -->
						<button v-if="sessionUser.isOwner" id="editSketchButton" class="btn btn-primary" @click="app.currentMode = 'editMode'">{{$t('general.edit')}}</button>
					</div>
					<div id="sideButtons" :class="{ showSideButtons }">
						<!-- Approve Button -->
						<op-button v-if="sketch.approveTo" id="approveButton" :button-class="{'btn btn-primary':1, 'btn-success': app.justApproved, 'loading': app.approving}" @click="approveSketch()" :extra="{[$t('general.reject')]: rejectSketch}">{{$t('general.approve')}}</op-button>

						<!-- Owner Fork button -->
						<button v-if="sessionUser.isOwner && sketch.visualID > 0" id="forkSketchLink" class="btn btn-link hidden-xs" @click="forkSketch">{{$t('general.saveAsFork')}}</button>

						<!-- Guest Fork button -->
						<button v-else-if="sessionUser.canFork" v-show="sketch.isDirty" id="forkSketchButton" class="btn btn-primary" @click="forkSketch">{{$t('general.saveAsFork')}}</button>

						<!-- SaveSketchButton is only displayed on /create -->
						<button v-if="sessionUser.isOwner && sketch.visualID < 0" id="saveSketchButton" class="btn btn-primary" v-show="app.currentMode != 'editMode'  && (app.saving || sketch.isDirty)" v-text="$t('general.save')" @click="app.currentMode = 'editMode'" @click="saveSketch(false)"></button>

						<!-- Submit Button on Form -->
						<button id="submitSketchButton" :class="{ 'btn btn-primary': 1,  'btn-success': app.justSaved, 'loading': app.saving}" v-text="$t('general.submit')" form="editSketchForm" type="submit" v-show="app.currentMode == 'editMode'"></button>

						<!-- Quick Save on existing -->
						<button v-if="sessionUser.isOwner && sketch.visualID > 0" id="quickSaveButton" :class="{ 'btn btn-primary': 1, 'btn-success': app.justSaved, 'loading': app.saving}" v-text="$t('general.save')" @click="saveSketch(true)"></button>
					</div>

											<div id="embedPageLink">
							<a target="_blank" class="white" href="https://openprocessing.org/sketch/2327714"><span class="icon icon_fork_white"></span> {{$t('general.fork')}}</a>
						</div>
									</div>

			</div>

		</div>

		<div id="fullscreenWarning" v-if="app.isFullscreen && !app.isEmbedPage" v-cloak>Press escape to exit fullscreen</div>
		<div id="sketch" :class="{active: app.currentMode == 'playMode', panel: true, hasFrameBorder: sketch.hasFrameBorder, showRuler: app.showRuler}" :style="{width: app.sketchWidth + 'px'}">
			<sketch-ruler v-if="app.showRuler" :origin="app.rulerOrigin" :mouse="app.rulerMouse" :dark-mode="app.darkMode"></sketch-ruler>
			<opc-controls id="OPC" class="dark floatingOverlay" @collapsed="d=>this.app.opcCollapsed = d" :frame="getSketchFrame()" input-class="dark" v-cloak></opc-controls>
			<div id="introPanel" :class="{'active': app.instructionTimer < app.instructionDuration}" v-if="!sketch.newSketch && app.showInstructions && app.layout != 'layout_split' && sketch.license != 'none'" @mouseenter="app.instructionPaused=1" @mouseleave="app.instructionPaused=0" v-cloak>
				<p class="instructions" v-if="sketch.instructions">{{sketch.instructions}}</p>
				<p v-if="sketch.parentSketch">
					<span class="icon icon_fork_small_white pretext"></span>
					<i18n path="sketch.forkInfo">
						<template v-slot:sketchtitle>
							<a :href="'/@'+((sketch.parentSketch.user && sketch.parentSketch.user.username) || sketch.parentSketch.username)+'/'+sketch.parentSketch.visualID">{{sketch.parentSketch.title}}</a>
						</template>
						<template v-slot:username>
							<a :href="'/@'+((sketch.parentSketch.user && sketch.parentSketch.user.username) || sketch.parentSketch.username)">{{sketch.parentSketch.fullname}}</a>
						</template>
					</i18n>
				</p>
				<p v-if="sketch.license && sketch.license != 'none'">
					<a :href="sketch.licenseObject.url" target="_blank">
						<span class="icon icon_license_white pretext"></span>
						<span>CC {{sketch.licenseObject.short}}</span>
					</a>
				</p>
				<div id="instructionCounter" :style="{'width': instructionPercent + '%'}"></div>
			</div>
			<div id="archiveInfo" class="container" v-if="+sketch.isPjs === 0">
				<div class="bg" :style="{'background-image': `url('https://kyoko.openprocessing.org/thumbnails/visualThumbnail2327714@2x.jpg?hash=20240814012949')`}"></div>
				<div class="row middle">
					<div class="col-xs-12 text-center">
						<img src="/assets/23.3.3/img/icons/icon_archive_large.png">
						<h2>Archived Sketch</h2>
						<p>This sketch is created with an older version of Processing,
							<br> and doesn't work on browsers anymore.
						</p>
						<p>
							<a href="#" class="btn btn-primary red" onclick="window.vueApp.app.currentMode = 'codeMode'; return false;">View Source Code</a>
						</p>
					</div>
				</div>
			</div>
			<form id="sketchForm" target="sketchIframe" action="//preview.openprocessing.org/sketch/preview" method="POST">
				<input id="sketchConfig" type="hidden" name="config" value="" />
			</form>
		</div>
		<sketch-recorder ref="recorder" v-if="app.recordMode" :screenshot="app.recordPostView !== 'shareSidePanel'" :duration="app.recordingDuration" @recording-ready="updateRecording" @recording-error="d=>{app.recordMode = false; OP.showErrorModal(d);}" @done="app.recordMode = false"
			:is-member="app.recordPostView === 'shareSidePanel' || sessionUser.membershipType"></sketch-recorder>

		<div id="infoPanel" v-if="!sketch.newSketch" class="inactive" :class="{'panel':1, 'active': app.currentMode == 'infoMode', 'inactive': app.currentMode !== 'infoMode'}" v-cloak>
			<!-- <img :src="sketch.thumbURL" class="thumbnailBackground" /> -->
			<div class=" row forkData" v-if="sketch.parentSketch">
				<div class="col-xs-12">
					<span class="icon icon_fork_small_white pretext"></span>
					<i18n path="sketch.forkInfo">
						<template v-slot:sketchtitle>
							<a :href="'/@'+((sketch.parentSketch.user && sketch.parentSketch.user.username) || sketch.parentSketch.username)+'/'+sketch.parentSketch.visualID">{{sketch.parentSketch.title}}</a>
						</template>
						<template v-slot:username>
							<a :href="'/@'+((sketch.parentSketch.user && sketch.parentSketch.user.username) || sketch.parentSketch.username)">{{sketch.parentSketch.fullname}}</a>
						</template>
					</i18n>
				</div>
			</div>
			<h1 class="sketchTitle geist">{{ sketch.title }}</h1>
			<div class="authorContainer visible-xs">
				<op-user :user="user" style="width: 45px; height: 45px; margin-right: 10px;"></op-user>
				<div class="sketchAuthor">{{$t('general.by')}}<br />
					<a :href="`/@${user.username}`">{{user.fullname}}</a>
				</div>
			</div>
			<div class="row">
				<div v-if="sketch.description && sketch.description.length > 0" class="description geist col-xs-12 col-sm-8">
					A fork of Robot Family by Richard Bourne. Created for the #WCCChallenge
Walking robot horse.				</div>
				<div v-if="sketch.tags.length > 0 || +sketch.isDraft || +sketch.isTemplate" class="sketchBadges geist col-xs-12 col-sm-8">
					<span v-for="tag in sketch.tags" class="tag" v-bind:key="tag"><a :href="'/browse/?q=' + tag + '&time=anytime&type=tags'">#{{tag}}</a>&nbsp;</span>
					<span v-if="+sketch.isDraft" class="tag">[Draft]&nbsp;</span>
					<span v-if="+sketch.isTemplate" class="tag">[Template]&nbsp;</span>
				</div>
				<div v-if="sketch.instructions && sketch.instructions.length > 0" :label="$t('sketch.instructions')" class="instructions col-xs-12 col-sm-8 col-md-6">
					<div class="content">
						Tap to speed up horse. Drag to rotate the scene. Spread fingers to zoom in. Squeeze  fingers to zoom out.
Press any key to save screen image.					</div>
				</div>
			</div>
			<div class="spacer flex1"></div>
			<div class="metadata flex-column flex-gap">
				<ul class="row">
					<li v-if="sketch.classes.length> 0" :label="$t('sketch.submittedTo')" class="col-xs-12 col-sm-6 col-lg-4 clearDiv" style="margin-bottom: 60px;">
						<div class="" v-for="c in sketch.classes" :key="c.collectionID">
							<a :href="`/class/${c.collectionID}`">{{c.title}}</a>
						</div>
					</li>
					<li v-tippy :label="$t('sketch.license')" class="col-xs-12 col-sm-3 col-md-2" :content="sketch.licenseObject['name']">
						<a href="https://creativecommons.org/licenses/by-sa/3.0" target="_blank">
							CC BY-SA						</a>
					</li>
					<li v-tippy class="date capitalize col-xs-6 col-sm-3 col-md-2" :label="$t('sketch.createdOn')" :content="sketchCreatedOnFull">
						{{sketchCreatedOn}}
					</li>
					<li v-tippy class="updatedOn date capitalize col-xs-6 col-sm-3 col-md-2" :label="$t('sketch.updatedOn')" :content="sketchUpdatedOnFull">
						{{sketchUpdatedOn}}
					</li>
				</ul>
				<ul class="row flex-bottom flex-wrap" v-if="sessionUser.isOwner">
					<li :label="$t('sketch.whoCanSeeSketch')" class="whoCanSeeSketch col-xs-6 col-sm-3 col-md-2">
						{{$t('sketch.privacy-anyone')}}																							</li>
					<li :label="$t('sketch.whoCanSeeCode')" class="whoCanSeeCode col-xs-6 col-sm-3 col-md-2">{{hiddenCodeText}}</li>
					<li :label="$t('sketch.whoCanComment')" class="whoCanComment col-xs-6 col-sm-3 col-md-2">{{commentModeText}}</li>
				</ul>
			</div>
		</div>
		<div id="editSketchPanel" v-if="!app.isEmbedPage" :class="{'panel':1, 'active': app.currentMode == 'editMode', 'inactive': app.currentMode !== 'editMode'}" :lang="sessionUser.language" v-cloak>
			<sketch-saver id="editSketchForm" ref="sketchSaver" :sketch="sketch" :session-user="sessionUser" :app="app" @delete="showDeleteSketchModal"></sketch-saver>
		</div>
		<sketch-backup-warning v-show="app.isBackup"></sketch-backup-warning>
		<sketch-tutorial v-if=" sketch.isTutorial && app.isMobile" v-show="app.currentMode == 'tutorialMode'" :class="{'panel':1, 'active': app.currentMode == 'tutorialMode', 'inactive': app.currentMode !== 'tutorialMode'}" :theme="app.darkMode ? 'dark':'light'" @ready="onTutorialPageChange" @page-change="onTutorialPageChange"></sketch-tutorial>

		<div id="codePanel" :class="{'panel':1, 'active': app.currentMode == 'codeMode', 'inactive': app.currentMode !== 'codeMode', 'readOnly': app.editorReadOnly, 'codeControl': app.codeControl}" :style="{'padding-bottom': app.isConsoleVisible*codePanelConsolePadding + 'px'}" v-cloak>
			<sketch-tutorial v-if="sketch.isTutorial && !app.isMobile" :theme="app.darkMode ? 'dark':'light'" :style="{width: app.tutorialWidth + '%'}" @ready="onTutorialPageChange" @page-change="onTutorialPageChange"></sketch-tutorial>

			<div class="hiddenCodeContainer" v-if="sketch.sourceHidden">
				<p>
					<img src="/assets/23.3.3/img/icons/icon_hiddenCode.png" />
				</p>
				<p>As a
					<a href="/membership/" target="_blank">Plus+ Member</a> feature, this source code is hidden by the
					owner.
				</p>
			</div>
			<div id="codeContainer" :class=" {'codeContainer noLang':1, 'showComments' : app.sidePanel=='comments' }" v-if="!sketch.sourceHidden">
				<div id="codeTabs">
					<div id="editorLoadingIcon" v-show="app.editorLoading" :class="{'icon icon_loader': 1, 'white': app.darkMode}"></div>
					<sketch-codetabs v-model="sketch.currentCodeObject" :tabs="sketch.currentVersion.codeObjects"></sketch-codetabs>
					<div id="tabControls" v-if="!app.isEmbedPage">
						<div class="icon icon_minimize_small pointer" :class="{'white': app.darkMode}" @click="app.isFullscreen = !app.isFullscreen" v-show="app.isFullscreen" v-tippy :content="getShortcutTooltip($t('sketch.exitFullscreen'), app.keyboardShortcuts.fullscreen)"></div>
						<div :class="{'icon pointer':1, 'white': app.darkMode, 'icon_layout_default': app.layout == 'layout_split', 'icon_layout_split': app.layout == 'layout_default'}" @click="toggleLayout" v-show="!app.isMobile" v-tippy :content="getShortcutTooltip($t('sketch.switchLayout'), app.keyboardShortcuts.layout)"></div>
						<div :class="{'icon pointer':1, 'white': app.darkMode, 'icon_settings_small':!app.showCodeOptions, 'icon_x_small':app.showCodeOptions}" @click="toggleCodeOptions" v-tippy :content="getShortcutTooltip($t('general.settings'), app.keyboardShortcuts.settings)"></div>
					</div>
				</div>
				<div id="codeMirrorContainer" :style="{width: app.layout == 'layout_split'? app.codeWidth + '%': null}">
					<resizer id="codeResizeHandle" horizontal :max="app.codeMaxWidth" :min="app.codeMinWidth" :default="app.codeDefaultWidth" @update="d=>{ app.codeWidth = d;}" save-preference="editor-codeWidthPerc" reference="#codeContainer"></resizer>
					<codemirror
						:code-object="sketch.currentCodeObject"
						:linting="app.lintingEnabled"
						:close-brackets="app.closeBracketsEnabled"
						:markers-visible="app.sidePanel === 'comments'"
						:autocomplete="app.autocompleteEnabled"
						:p5reference="p5reference"
						@play="playSketch"
						@dirty="sketch.isDirty = true"
						@save="saveDefault"
						@select="d=>sketch.currentCodeObject.selection = d"
						@fullscreen="app.isFullscreen = !app.isFullscreen"
						@layout="toggleLayout"
						@settings="app.showCodeOptions = !app.showCodeOptions"
						@ruler="toggleRuler"
						:read-only="app.editorReadOnly"
						@focus="app.editorFocused = true"
						@blur="app.editorFocused = false"
						:theme="app.darkMode ? 'dark':'light'" :font-size="app.editorFontSize"></codemirror>
					<sketch-code-control v-if="app.showCodeControlOverlay && !sessionUser.isRestricted" @close="app.showCodeControlOverlay = false" :lang="sessionUser.language" class="floatingOverlay"></sketch-code-control>
					<sketch-codecontrol-actions id="codeControlActions" :class="{'fadeIn': app.codeControl && app.editorFocused}"></sketch-codecontrol-actions>
				</div>
			</div>
			<div id="codeOptions" :class="{'active': app.showCodeOptions}" :lang="sessionUser.language">
				<!-- Nav tabs -->
				<ul id="codeOptionsTabs" class="nav nav-tabs" role="tablist">
					<li role="presentation" :class="{'active': app.codeOptions == 'sketchSettings'}">
						<a @click="app.codeOptions='sketchSettings'" href="javascript:;" aria-controls="sketchSettings" role="tab">{{$t("sketch.sketch")}}</a>
					</li>
					<li role="presentation" :class="{'active': app.codeOptions == 'sketchFiles'}">
						<a id="filesLink" @click="app.codeOptions='sketchFiles'" href="javascript:;" aria-controls="sketchFiles" role="tab">{{$t("sketch.files")}}</a>
					</li>
					<li role="presentation" id="editorSettingsTab" :class="{'active': app.codeOptions == 'editorSettings'}">
						<a id="editorSettingsLink" @click="app.codeOptions='editorSettings'" href="javascript:;" aria-controls="editorSettings" role="tab">{{$t("sketch.editor")}}</a>
					</li>
					<li role="presentation" id="codeVersionsTab" v-if="!sketch.newSketch && (sessionUser.isOwner || sessionUser.isProfessorOf)" :class="{'active': app.codeOptions == 'codeVersions'}" v-cloak>
						<a id="codeVersionsLink" @click="loadHistory(); app.codeOptions='codeVersions'" href="javascript:;" aria-controls="codeVersions" role="tab"><span class="icon icon_revert_white"></span></a>
					</li>
					<li role="presentation" id="codeReferenceTab" v-show="sketch.isPjs == 2 || sketch.isPjs == 3" :class="{'active': app.codeOptions == 'codeReference'}">
						<a @click="app.codeOptions='codeReference'" href="javascript:;" aria-controls="codeReference" role="tab"><span class="icon icon_book_white"></span></a>
					</li>
				</ul>

				<div class="tab-content">
					<div role="tabpanel" class="tab-pane" :class="{'active': app.codeOptions == 'sketchSettings'}" id="sketchSettings">
						<div class="formItem" id="sketchModeOptions">
							<select class="versionDropdown" v-model="sketch.engine" v-show="sketch.isPjs == 2 || sketch.isPjs == 1">
								<option v-for="engine in currentEngineVersions" :key="engine.libraryID" :value="engine">{{engine.version}}</option>
							</select>
							<op-radio :label="$t('sketch.mode')" class="noLang" :options="sketchModeOptions" v-model="sketch.isPjs"></op-radio>
							<div class="warningBox dark" v-if="sketch.isPjs == 1">
								{{$t('sketch.mode-pjs')}} <a href="https://intercom.help/openprocessing/en/articles/3250763-processingjs-deprecation-notice" target="_blank">{{$t('general.learnMore')}}</a>
							</div>
							<div class="description">Select mode or <a class="pointer" name="sketchTemplateHandle" @click="app.loadTemplates = true">a template <span class=" icon icon_caret_down_small_white posttext"></span></a></div>
							<tippy v-if="app.loadTemplates" show-on-init=true to="sketchTemplateHandle" placement="bottom" trigger="click" theme="dark" touch=true delay=0 interactive="true" size="large">
								<templates :sketch="sketch" :user="sessionUser"></templates>
							</tippy>
						</div>
						<op-toggle id="tutorialModeOptions" v-show="sessionUser.isOwner" v-model="sketch.isTutorial" :label="$t('sketch.tutorialMode')" :description="$t('sketch.tutorialModeDescription') + ` <a href=' https://openprocessing.org/sketch/672194' target='_blank'>` + $t('general.learnMore') + `</a>`">
						</op-toggle>

						<op-toggle v-if="false" class="level-1" v-show="sessionUser.isOwner && sketch.isTutorial != 0" :value="sketch.isTutorial == 2" :label="$t('sketch.singleTutorialCode')" :description="'Beta: ' + $t('sketch.singleTutorialCodeDescription')" @change="sketch.isTutorial = $event? 2: 1">
						</op-toggle>

						<op-toggle id="liveCodeOptions" v-model="app.liveCodeEnabled" :label="$t('sketch.liveCollaboration')" :disabled="liveCodeNotAllowed" :description="liveCodeDescription"><op-clipboard v-if="app.liveCodeEnabled">{{liveCodeLink}}</op-clipboard></op-toggle>


						<op-toggle v-if='sketch.isPjs == 1 || sketch.isPjs == 2' v-model="sketch.hasFrameBorder" :label="$t('sketch.showcaseSketch')" :description="sketch.hasFrameBorder? $t('sketch.showcaseSketchDescription'): ''"></op-toggle>

						<op-toggle v-model="sketch.loopProtect" :label="$t('sketch.loopProtect')" :description="sketch.loopProtect? $t('sketch.loopProtectDescription'): ''"></op-toggle>

						<sketch-libraries :sketch="sketch" :default="app.defaultLibraries" :custom="app.customLibraries"></sketch-libraries>
					</div>
					<div role="tabpanel" class="tab-pane" :class="{'active': app.codeOptions == 'sketchFiles'}" id="sketchFiles">
						<file-explorer v-if="sketch.files || app.codeOptions == 'sketchFiles'" :sketch="sketch" :user="sessionUser" :can-edit="sessionUser.isOwner" :can-upload="sessionUser.canUploadFiles"></file-explorer>
					</div>
					<div role="tabpanel" class="tab-pane" :class="{'active': app.codeOptions == 'editorSettings'}" id="editorSettings">
						<op-slider :label="$t('sketch.textSize')" min="12" max="36" step="2" v-model="app.editorFontSize" :default="16" input-class="dark"></op-slider>
						<div id="layoutOptions" class="formItem">
							<div class="formTop">
								<label>{{$t('sketch.layout')}}</label>
								<div class="text-right">
									<input name="layoutOption" id="layout_default" value="layout_default" type="radio" v-model="app.layout" />
									<label for="layout_default">
									</label>
									<input name="layoutOption" id="layout_split" value="layout_split" type="radio" v-model="app.layout" />
									<label for="layout_split">
									</label>
									<input name="layoutOption" id="layout_overlay" value="layout_overlay" type="radio" v-model="app.layout" />
									<label for="layout_overlay" class="hide">
									</label>
								</div>
							</div>
							<div class="description">{{$t('sketch.layoutDescription')}}</div>
						</div>
						<op-toggle id="darkModeOptions" :label="$t('sketch.darkMode')" v-model="app.darkMode" :description="$t('sketch.darkModeDescription')"></op-toggle>
						<op-toggle id="consoleOptions" :label="$t('sketch.console')" v-model="app.showConsole" :description="$t('sketch.consoleDescription')"></op-toggle>
						<op-toggle :label="$t('sketch.ruler')" v-model="app.showRuler" :description="$t('sketch.rulerDescription')"></op-toggle>
						<op-toggle id="lintOptions" :label="$t('sketch.linting')" v-model="app.lintingEnabled" :disabled="+sketch.isPjs < 2" :description="+sketch.isPjs < 2 ? $t('sketch.lintingDescription-p5js') : $t('sketch.lintingDescription')"></op-toggle>
						<op-toggle id="autocompleteOptions" :label="$t('sketch.autocomplete')" v-model="app.autocompleteEnabled" :description="$t('sketch.autocompleteDescription')"></op-toggle>
						<op-toggle :label="$t('sketch.closeBrackets')" v-model="app.closeBracketsEnabled" :description="$t('sketch.closeBracketsDescription')"></op-toggle>
						<op-toggle :label="$t('sketch.ligatures')" v-model="app.ligaturesEnabled" :description="$t('sketch.ligaturesDescription')"></op-toggle>

						<div id="keyboardShortcuts">
							<label>{{$t('sketch.shortcuts')}}</label>
							<p>
							<ul id="keyboardTable">
								<li class="flex keyboardItem flex-wrap" v-for="(k,i) in app.keyboardShortcuts" :key="i" v-if="k.showInSettings">
									<div v-if="k.category" class="keyboardCategory"><b v-html="k.category"></b></div>
									<div class="description keyboardLabel">{{k.label}}</div>
									<div class="description keyboardDescription">{{k.description}}</div>
								</li>
							</ul>
							</p>
						</div>
					</div>
					<div role="tabpanel" class="tab-pane" :class="{'active': app.codeOptions == 'codeVersions'}" id="codeVersions" v-if="!sketch.newSketch && !sketch.isTutorial && (sessionUser.isOwner || sessionUser.isProfessorOf)">
						<div v-if="sessionUser.isOwner && +sessionUser.membershipType == 0" class="versionPlusPromo">
							<p class="grey">Versions are only kept for 7 days.
								<br /><a href="/membership/" target="_blank" data-umami-event="plusPromo-versions">Join Plus+</a> to keep versions indefinitely!
							</p>
							<p><a class=" btn btn-default fullWidth" href="/membership/" target="_blank">{{$t('general.joinPlus')}}</a>
							</p>
							<p>
								<hr class="grey" />
							</p>
						</div>
						<div class="description small">
							<p v-if="sketch.versions.length> 20">{{$t('sketch.versionsSummarized')}}</p>
						</div>
						<ul>
							<div v-if="!app.historyLoaded" class="text-center"><span class="icon icon_loader_white"></span></div>
							<version v-for="v of sketch.versions" v-if="app.historyLoaded" :version="v" :is-dirty="sketch.isDirty" :key="v.versionID" :can-restore="sessionUser.isOwner"></version>
						</ul>
					</div>
					<code-reference role="tabpanel" class="tab-pane" :class="{'active': app.codeOptions == 'codeReference'}" id="codeReference" :engine="sketch.engine" :p5reference="p5reference"></code-reference>
				</div>
				<div v-if="!sessionUser.membershipType" class="adContainer">
					<i18n path="sketch.plusPromo">
						<a :href="/membership/" target="_blank" data-umami-event="plusPromo-codeSettings">{{ $t('general.joinPlus') }}</a>
					</i18n>
				</div>

			</div>
		</div>
		<div id="heartSidePanel" class="sidePanel hidden-xs container" v-show="app.sidePanel == 'hearts'">
			<op-userlist v-if="!app.isEmbedPage && app.sidePanel == 'hearts'" limit="40" :list="sketch.hearts" id="heartsList">
			</op-userlist>

		</div>
		<div id="commentSidePanel" class="sidePanel container" v-show="app.sidePanel == 'comments'" v-if="sessionUser.canInteractWith">
			<div id="commentsSummaryWarning" v-show="commentsConfig.lineNo?.number">
				{{ $tc('sketch.displayingComments', commentsConfig.lineNo?.number) }} <a href="#" @click="resetComments">{{ $t('general.showAll') }}</a>
			</div>
			<div v-show="!commentsLoaded" class="text-center loaderContainer"><span class="icon icon_loader_white"></span></div>
			<!-- Comment List -->
			<div class="comments" v-if="commentsConfig.commentsInitialized == true || app.sidePanel == 'comments'">
				<comment v-for="c of filteredComments" :comment="c" @hook:mounted="checkForScroll" :session-user="sessionUser" :key="c.commentID" :can-edit="sessionUser.isOwner || c.userID == sessionUser.userID"></comment>
			</div>
			<!-- New Comment Section -->
			<new-comment v-if="app.newCommentReady || app.sidePanel == 'comments'" v-show="sessionUser.userID > 0 && sessionUser.isEmailVerified > 0" id="newCommentContainer" :session-user="sessionUser" :user="user" :template="commentsConfig.newCommentTemplate" @ready="app.newCommentReady = true"></new-comment>
			<!-- Verification Warning -->
			<div v-show="sessionUser.userID> 0 && sessionUser.isEmailVerified < 1" id="verifyToComment">
				<div class="newComment">
					<div class="col-xs-12 text-center">
						<p>Please verify your email to comment</p>
						<p class="text-center"><a :class="{'btn btn-primary':1, 'loading':app.verifyingEmail}" href="#" @click="sendVerifyEmail">Verify Email</a></p>
						<p></p>
					</div>
				</div>
			</div>
			<!-- Guest User Join Callout -->
			<div v-show="sessionUser.userID == 0" id="joinToComment">
				<div class="col-xs-12">
					<a class="btn btn-primary" href="/home/join">Join to Comment</a>
				</div>
			</div>
		</div>
		<div id="forkSidePanel" class="sidePanel hidden-xs container" v-show="app.sidePanel == 'forks'">
			<p class="text-center" v-if="sketch.forks == null"><span class="icon icon_loader_white"></span></p>
			<fork-list v-if="app.sidePanel == 'forks'" id="forkList" :sketch="sketch" :fullname="user.fullname" :top-level="true"></fork-list>
			<div id="forkButtonContainer" class="row text-center" v-if="sessionUser.canFork">
				<button type="button" id="forkThisSketchButton" v-bind:class="{ 'btn-success': app.justSaved,'disabled': app.justSaved, 'loading': app.saving, 'btn btn-primary': 1 }" @click="forkSketch">{{$t('general.fork')}}</button>
			</div>
		</div>


		<div id="shareSidePanel" class="sidePanel hidden-xs container" v-show="app.sidePanel == 'share'" :lang="sessionUser.language">
			<div id="shareLinks">
				<div>
					<a href="javascript:;" @click="app.isFullscreen = true">
						<span class="icon icon_maximize_small_white pretext"></span> {{$t('sketch.fullscreen')}}
					</a>
				</div>
				<div>
					<a href="javascript:;" @click="app.recordingDuration = null; app.recordPostView = 'shareSidePanel'; app.recordMode = true; ">
						<span :class="{'icon pretext':1, 'icon_record_small_white': !app.recordingInProgress, 'icon_loader_white': app.recordingInProgress}"></span> {{$t('sketch.record')}}</a>
				</div>
				<div>
					<a name="shareSketchLink" href="javascript:;">
						<span class="icon icon_social_white pretext"></span> {{$t('sketch.share')}}
					</a>
					<tippy to="shareSketchLink" delay="0" trigger="click" theme="grey" interactive="true" size="medium">
						<p class="text-left">
							<a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=http%3A//openprocessing.org/sketch/2327714">
								<span class="icon icon_facebook_white pretext"></span> Facebook
							</a>
						</p>
