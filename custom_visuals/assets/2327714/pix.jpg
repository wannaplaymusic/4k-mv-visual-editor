pm\/p5@0.5.11\/lib\/p5.min.js","docUrl":"https:\/\/p5js.org","releaseUrl":"https:\/\/api.github.com\/repos\/processing\/p5.js\/releases"},{"libraryID":22,"title":"p5.dom","version":"0.3.3","for":2,"forVersion":"","highlight":null,"description":"(p5.dom is now part of p5js, no need to enable if using v0.10+).<br\/>p5.dom library lets you use video, audio, webcam, input, and text.<br\/>\nExamples: <a target=\"_blank\" href=\"https:\/\/www.openprocessing.org\/sketch\/565368\">Dom<\/a> - <a target=\"_blank\" href=\"https:\/\/www.openprocessing.org\/sketch\/565603\">Video<\/a> ","category":"UI Helpers","url":"https:\/\/cdn.jsdelivr.net\/npm\/p5@0.5.11\/lib\/addons\/p5.dom.min.js","docUrl":"http:\/\/p5js.org\/reference\/#\/libraries\/p5.dom","releaseUrl":""},{"libraryID":23,"title":"p5play","version":"1.1cff5bd","for":2,"forVersion":"","highlight":null,"description":"p5play is a JavaScript game engine that uses p5.js for rendering and Box2D for physics. <a href=\"\/sketch\/1721113\" target=\"_blank\">Demo<\/a>","category":"Physics & Game Mechanics","url":"https:\/\/cdn.jsdelivr.net\/gh\/molleindustria\/p5.play@1cff5bd1fd45c450284380c19ade395ce1e39a11\/lib\/p5.play.js","docUrl":"http:\/\/p5play.molleindustria.org\/","releaseUrl":""},{"libraryID":24,"title":"p5js","version":"0.5.16","for":null,"forVersion":"","highlight":null,"description":"","category":"Engine","url":"https:\/\/cdn.jsdelivr.net\/npm\/p5@0.5.16\/lib\/p5.min.js","docUrl":"https:\/\/p5js.org","releaseUrl":"https:\/\/api.github.com\/repos\/processing\/p5.js\/releases"},{"libraryID":25,"title":"p5.dom","version":"0.3.4","for":2,"forVersion":"","highlight":null,"description":"(p5.dom is now part of p5js, no need to enable if using v0.10+).<br\/>p5.dom library lets you use video, audio, webcam, input, and text.<br\/>\nExamples: <a target=\"_blank\" href=\"https:\/\/www.openprocessing.org\/sketch\/565368\">Dom<\/a> - <a target=\"_blank\" href=\"https:\/\/www.openprocessing.org\/sketch\/565603\">Video<\/a> ","categ