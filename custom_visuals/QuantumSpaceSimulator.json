{
    "name": "QuantumSpaceSimulator",
    "code": "// === Tab: mySketch.js ===\nfunction setup() {\n\tcreateCanvas(windowWidth, windowHeight);\n\tbackground(100);\n}\n\nfunction draw() {\n\tcircle((window.simulatedMouseX !== undefined ? window.simulatedMouseX : (typeof sub_bass !== 'undefined' ? map(sub_bass, 0, 1, width*0.1, width*0.9) : (typeof live_centroid !== 'undefined' ? map(live_centroid, 100, 4000, 0, width) : mouseX))), (window.simulatedMouseY !== undefined ? window.simulatedMouseY : (typeof percussive !== 'undefined' ? map(percussive, 0, 1, height, 0) : (typeof roughness !== 'undefined' ? map(roughness, 0, 1, height*0.2, height*0.8) : mouseY))), 20);\n}\n\n",
    "frequency": 50,
    "storyboard_weight": 50,
    "post_fx_intensity": 50,
    "custom_html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WCCChallenge \"Radioactivity\" - Ixtam Quantum Remix</title>\n    <!-- p5.js library -->\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js\"></script>\n    <!-- lil-gui library for advanced controls -->\n    <script src=\"https://cdn.jsdelivr.net/npm/lil-gui@0.19\"></script>\n    \n    <style>\n        body {\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n            background-color: #050505;\n            font-family: 'Courier New', Courier, monospace;\n        }\n        canvas {\n            display: block;\n        }\n        /* Ixtam Custom Branding Overlay */\n        #ixtam-branding {\n            position: absolute;\n            bottom: 20px;\n            left: 20px;\n            color: #ccff00;\n            pointer-events: none;\n            text-shadow: 0 0 10px rgba(204, 255, 0, 0.8), 0 0 20px rgba(204, 255, 0, 0.4);\n            z-index: 10;\n        }\n        #ixtam-branding h1 {\n            margin: 0;\n            font-size: 26px;\n            letter-spacing: 3px;\n            text-transform: uppercase;\n            font-weight: 900;\n        }\n        #ixtam-branding p {\n            margin: 5px 0 0 0;\n            font-size: 13px;\n            color: #e0e0e0;\n            letter-spacing: 1px;\n        }\n        /* GUI styling for radioactive hazardous vibe */\n        .lil-gui {\n            --background-color: rgba(15, 15, 10, 0.95);\n            --text-color: #ccff00;\n            --title-background-color: #222a00;\n            --widget-color: #3d4d00;\n            --hover-color: #5c7300;\n            --focus-color: #ccff00;\n            --number-color: #ff3366;\n            --string-color: #00ffff;\n            border: 1px solid #3d4d00;\n        }\n    </style>\n</head>\n<body>\n\n    <div id=\"ixtam-branding\">\n        <h1>IXTAM // QUANTUM ISOTOPE</h1>\n        <p>WCCChallenge: Radioactivity | Mandelbox Core Engine</p>\n    </div>\n\n<script>\n/**\n * IXTAM - WCCChallenge \"Radioactivity\" [REMIX TOTAL]\n * Motor de Raymarching Fractal re-escrito a un Híbrido Mandelbox/KIFS.\n * Produce estructuras cristalinas alienígenas (Alien Quantum Core).\n * Post-procesado con Bloom Aditivo + Aberración Cromática de radiación.\n */\n\n// --- SHADERS DEFINITIONS ---\n\nconst vertShader = `#version 300 es \nin vec3 aPosition;\nin vec2 aTexCoord;\nout vec2 vTexCoord;\nvoid main() { \n    vTexCoord = aTexCoord;\n    gl_Position = vec4(aPosition * 2.0 - 1.0, 1.0); \n}`;\n\n// Fractal Mandelbox Shader\nconst fragMain = `#version 300 es\nprecision highp float;\nout vec4 fragColor;\n\nuniform vec2 u_resolution; \nuniform float u_time;\nuniform vec2 u_mouse;\nuniform int u_palette;\n\n// Ixtam Custom Controls\nuniform float u_iter;\nuniform float u_speed;\nuniform float u_zoom;\nuniform vec2 u_mutation;\nuniform bool u_mouseFollow;\nuniform float u_scale;\nuniform float u_minRad;\nuniform float u_fixedRad;\nuniform float u_foldLimit;\nuniform float u_fogDensity;\nuniform float u_twist;\n\n#define PI 3.14159265359\n#define TAU 6.28318530718\n\nfloat energyGlow = 0.0;\nvec3 orbitTrap; // Para colorear basado en la órbita del fractal\n\n// Nuevas Paletas IXTAM\nvec3 getPalette(float t) {\n    vec3 a, b, c, d;\n    if (u_palette == 0) { // Cherenkov Blue (Radiación de reactor)\n        a = vec3(0.1, 0.4, 0.7); b = vec3(0.0, 0.5, 0.8); c = vec3(1.0, 1.0, 1.0); d = vec3(0.0, 0.2, 0.4);\n    } else if (u_palette == 1) { // Uranium Glass (Verde Tóxico Intenso)\n        a = vec3(0.2, 0.7, 0.1); b = vec3(0.3, 0.8, 0.2); c = vec3(1.0, 1.0, 1.0); d = vec3(0.2, 0.5, 0.1);\n    } else if (u_palette == 2) { // Bismuth Core (Multicolor Iridiscente)\n        a = vec3(0.5); b = vec3(0.5); c = vec3(2.0, 1.0, 0.0); d = vec3(0.5, 0.2, 0.25);\n    } else if (u_palette == 3) { // Tritium Flare (Magenta/Cyan)\n        a = vec3(0.5, 0.2, 0.6); b = vec3(0.6, 0.3, 0.7); c = vec3(1.0, 1.0, 0.5); d = vec3(0.8, 0.9, 0.3);\n    } else if (u_palette == 4) { // Ixtam Hazard (Naranja/Rojo Fuego)\n        a = vec3(0.8, 0.3, 0.0); b = vec3(0.9, 0.4, 0.1); c = vec3(1.0, 0.5, 0.0); d = vec3(0.0, 0.1, 0.2);\n    }\n    return a + b * cos(TAU * (c * t + d));\n}\n\n// Mandelbox Folds\nvoid sphereFold(inout vec3 z, inout float dz) {\n    float r2 = dot(z, z);\n    if (r2 < u_minRad) { \n        float temp = (u_fixedRad / u_minRad);\n        z *= temp; \n        dz *= temp;\n    } else if (r2 < u_fixedRad) { \n        float temp = (u_fixedRad / r2);\n        z *= temp; \n        dz *= temp;\n    }\n}\n\nvoid boxFold(inout vec3 z) {\n    z = clamp(z, -u_foldLimit, u_foldLimit) * 2.0 - z;\n}\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Mapa Fractal (Mandelbox Modificado)\nfloat map(vec3 z) {\n    vec3 offset = z;\n    float dr = 1.0;\n    \n    // Auto-Twist global animado\n    z.xy *= rot(u_time * u_twist);\n    z.xz *= rot(u_time * (u_twist * 0.5));\n    \n    vec2 mut = u_mutation;\n    if (u_mouseFollow) {\n        vec2 m = (u_mouse / u_resolution) * 2.0 - 1.0;\n        mut += m * 2.0; // Inyecta el ratón a la mutación fractal\n    }\n\n    orbitTrap = vec3(1e4);\n\n    for(float i = 0.0; i < 20.0; i++) {\n        if(i >= u_iter) break;\n        \n        boxFold(z);\n        sphereFold(z, dr);\n        \n        z = u_scale * z + offset;\n        dr = dr * abs(u_scale) + 1.0;\n        \n        // Mutación iterativa (deformación de Ixtam)\n        z.x += mut.x * sin(u_time + i);\n        z.y += mut.y * cos(u_time - i);\n        \n        orbitTrap = min(orbitTrap, abs(z));\n    }\n    \n    float r = length(z);\n    return r / abs(dr);\n}\n\n// Raymarching\nfloat march(vec3 ro, vec3 rd) {\n    float t = 0.0;\n    float max_dist = 20.0;\n    for(int i = 0; i < 90; i++) {\n        vec3 pos = ro + rd * t;\n        float d = map(pos);\n        if (d < 0.001 || t > max_dist) break;\n        t += d * 0.7; // 0.7 para mejorar la precisión en fractales complejos\n        \n        // Acumulación de energía radiactiva\n        energyGlow += 0.02 / (0.01 + abs(d)); \n    }\n    return t;\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / u_resolution.y;\n    \n    // Movimiento de cámara\n    float T = u_time * u_speed;\n    vec3 ro = vec3(3.0 * cos(T), 1.5 * sin(T*0.7), 3.0 * sin(T)) * u_zoom;\n    vec3 ta = vec3(0.0, 0.0, 0.0); // Mirando al centro\n    \n    // Matriz de vista\n    vec3 ww = normalize(ta - ro);\n    vec3 uu = normalize(cross(ww, vec3(0.0, 1.0, 0.0)));\n    vec3 vv = normalize(cross(uu, ww));\n    vec3 rd = normalize(uv.x * uu + uv.y * vv + 1.5 * ww);\n    \n    float t = march(ro, rd);\n    \n    vec3 col = vec3(0.0);\n    \n    if(t < 20.0) {\n        // Shading basado en orbit trap (Distancia a los ejes del fractal)\n        float trapVal = length(orbitTrap) * 0.1;\n        col = getPalette(trapVal - u_time * 0.2);\n        \n        // Niebla radiactiva\n        float fog = exp(-t * u_fogDensity);\n        col *= fog;\n    }\n    \n    // Añadir el brillo radiactivo atrapado en los rayos\n    vec3 glowColor = getPalette(u_time * 0.1 + 0.5);\n    col += glowColor * energyGlow * 0.015;\n    \n    // Tonemapping\n    col = 1.0 - exp(-col * 1.5);\n    \n    fragColor = vec4(col, 1.0);\n}\n`;\n\n// Post-Processing / Bloom + Aberración Cromática\nconst fragPost = `#version 300 es\nprecision highp float;\nout vec4 fragColor;\n\nuniform vec2 u_resolution; \nuniform sampler2D u_tex; \nuniform float u_bloom;\nuniform float u_aberration; // Nivel de radiación distorsionando el lente\nuniform float u_time;\n\nvoid main() {\n    vec2 uv = gl_FragCoord.xy / u_resolution.xy;\n    vec2 pixel = 1.0 / u_resolution.xy * u_bloom;\n    \n    // Aberración cromática (RGB split) basada en el centro\n    vec2 distFromCenter = uv - 0.5;\n    vec2 rOffset = distFromCenter * u_aberration * 0.02 * sin(u_time);\n    vec2 bOffset = distFromCenter * -u_aberration * 0.02 * cos(u_time);\n\n    vec4 original = vec4(\n        texture(u_tex, uv + rOffset).r,\n        texture(u_tex, uv).g,\n        texture(u_tex, uv + bOffset).b,\n        1.0\n    );\n    \n    // Bloom Gaussiano 9-tap\n    vec4 sum = vec4(0.0);\n    sum += texture(u_tex, uv - 4.0 * pixel) * 0.0162162162;\n    sum += texture(u_tex, uv - 3.0 * pixel) * 0.0540540541;\n    sum += texture(u_tex, uv - 2.0 * pixel) * 0.1216216216;\n    sum += texture(u_tex, uv - 1.0 * pixel) * 0.1945945946;\n    sum += texture(u_tex, uv) * 0.2270270270;\n    sum += texture(u_tex, uv + 1.0 * pixel) * 0.1945945946;\n    sum += texture(u_tex, uv + 2.0 * pixel) * 0.1216216216;\n    sum += texture(u_tex, uv + 3.0 * pixel) * 0.0540540541;\n    sum += texture(u_tex, uv + 4.0 * pixel) * 0.0162162162;\n    \n    // Combinar la aberración original con el brillo\n    fragColor = original + (sum * u_bloom);\n}\n`;\n\n// --- P5.JS SKETCH ---\n\nlet mainShader, postShader;\nlet fbo;\n\n// Ixtam Parameters State (Más controles avanzados)\nconst state = {\n    // Apariencia General\n    palette: \"Uranium Glass\",\n    radiationLevel: 7.0, \n    speed: 0.15,\n    zoom: 1.2,\n    \n    // Mandelbox Core Geometry\n    shapeScale: -1.75, // Negativo crea cavidades increíbles\n    minRadius: 0.35,\n    fixedRadius: 1.0,\n    foldLimit: 1.0,\n    \n    // Mutaciones y Entorno\n    mutationX: 0.0,\n    mutationY: 0.0,\n    twist: 0.1,\n    fogDensity: 0.15,\n    mouseFollow: true,\n    \n    // Post Proceso\n    bloomIntensity: 1.2,\n    chromaticAberration: 1.5,\n    \n    reset: function() {\n        this.shapeScale = -1.75;\n        this.minRadius = 0.35;\n        this.mutationX = 0;\n        this.mutationY = 0;\n        this.twist = 0.1;\n        this.zoom = 1.2;\n        this.speed = 0.15;\n    }\n};\n\nconst palettes = {\n    \"Cherenkov Blue\": 0,\n    \"Uranium Glass\": 1,\n    \"Bismuth Core\": 2,\n    \"Tritium Flare\": 3,\n    \"Ixtam Hazard\": 4\n};\n\nfunction setup() {\n    createCanvas(windowWidth, windowHeight, WEBGL);\n    pixelDensity(1);\n    noStroke();\n\n    mainShader = createShader(vertShader, fragMain);\n    postShader = createShader(vertShader, fragPost);\n    fbo = createFramebuffer({ format: FLOAT });\n    \n    // Setup Ixtam UI Control Panel (lil-gui)\n    const gui = new lil.GUI({ title: \"☣ IXTAM ISOTOPE REACTOR\" });\n    \n    const envFolder = gui.addFolder('Environment & Colors');\n    envFolder.add(state, 'palette', Object.keys(palettes)).name('Isotope Class');\n    envFolder.add(state, 'radiationLevel', 1.0, 15.0, 1.0).name('Complexity (Iter)');\n    envFolder.add(state, 'fogDensity', 0.0, 0.5).name('Radiation Fog');\n    envFolder.add(state, 'speed', 0.0, 1.0).name('Orbit Speed');\n    envFolder.add(state, 'zoom', 0.5, 4.0).name('Camera Zoom');\n    \n    const geoFolder = gui.addFolder('Quantum Geometry (Mandelbox)');\n    geoFolder.add(state, 'shapeScale', -3.0, 3.0).name('Structure Scale').listen();\n    geoFolder.add(state, 'minRadius', 0.01, 1.0).name('Min Fold Radius').listen();\n    geoFolder.add(state, 'fixedRadius', 0.5, 2.0).name('Max Fold Radius');\n    geoFolder.add(state, 'foldLimit', 0.5, 2.0).name('Bounding Box');\n    \n    const mutFolder = gui.addFolder('Unstable Mutations');\n    mutFolder.add(state, 'twist', -1.0, 1.0).name('Space Twist').listen();\n    mutFolder.add(state, 'mutationX', -0.5, 0.5).name('Destabilize X').listen();\n    mutFolder.add(state, 'mutationY', -0.5, 0.5).name('Destabilize Y').listen();\n    mutFolder.add(state, 'mouseFollow').name('Enable Hand Tracker');\n    \n    const postFolder = gui.addFolder('Post Processing FX');\n    postFolder.add(state, 'bloomIntensity', 0.0, 4.0).name('Glow Bloom');\n    postFolder.add(state, 'chromaticAberration', 0.0, 5.0).name('Lens Radiation');\n    \n    gui.add(state, 'reset').name('EMERGENCY RESET');\n}\n\nfunction draw() {\n    // 1. DIBUJAR EL FRACTAL MANDELBOX EN EL FRAMEBUFFER\n    fbo.begin();\n    clear();\n    shader(mainShader);\n    \n    mainShader.setUniform('u_resolution', [width, height]);\n    mainShader.setUniform('u_time', millis() / 1000.0);\n    mainShader.setUniform('u_mouse', [mouseX, mouseY]);\n    mainShader.setUniform('u_palette', palettes[state.palette]);\n    \n    mainShader.setUniform('u_iter', state.radiationLevel);\n    mainShader.setUniform('u_speed', state.speed);\n    mainShader.setUniform('u_zoom', state.zoom);\n    mainShader.setUniform('u_scale', state.shapeScale);\n    mainShader.setUniform('u_minRad', state.minRadius);\n    mainShader.setUniform('u_fixedRad', state.fixedRadius);\n    mainShader.setUniform('u_foldLimit', state.foldLimit);\n    \n    mainShader.setUniform('u_twist', state.twist);\n    mainShader.setUniform('u_fogDensity', state.fogDensity);\n    mainShader.setUniform('u_mutation', [state.mutationX, state.mutationY]);\n    mainShader.setUniform('u_mouseFollow', state.mouseFollow);\n    \n    rect(-width/2, -height/2, width, height);\n    fbo.end();\n\n    // 2. APLICAR POST-PROCESAMIENTO (BLOOM + CROMATISMO) A LA PANTALLA\n    resetShader();\n    shader(postShader);\n    postShader.setUniform('u_resolution', [width, height]);\n    postShader.setUniform('u_tex', fbo);\n    postShader.setUniform('u_bloom', state.bloomIntensity);\n    postShader.setUniform('u_aberration', state.chromaticAberration);\n    postShader.setUniform('u_time', millis() / 1000.0);\n    \n    rect(-width/2, -height/2, width, height);\n}\n\nfunction windowResized() {\n    resizeCanvas(windowWidth, windowHeight);\n    fbo = createFramebuffer({ format: FLOAT }); // Recrear FBO\n}\n</script>\n</body>\n</html>\n",
    "custom_css": "\n/* === 4K MV Pure Canvas - 全域控制項與 UI 面板極限無痕隱藏 === */\n.dg, .lil-gui, .qs_main, .opc-control, #opc-control-panel, .control-panel, .gui-container,\n.tp-dfwv, .tp-rotv, .tweakpane, [class*='tp-'], [class*='tweakpane'],\n[class*='gui'], [id*='gui'], [class*='control'], [id*='control'],\n[class*='instruction'], [id*='instruction'], [class*='info'], [id*='info'],\n[class*='fps'], [id*='fps'], [class*='overlay'], [id*='overlay'],\n[class*='panel'], [id*='panel'], [class*='toolbar'], [id*='toolbar'],\n.p5-control, .ui-container, #ui, #controls, .hud, [class*='hud'],\ninput, button, select, textarea, label, form, nav, header {\n  display: none !important;\n  visibility: hidden !important;\n  opacity: 0 !important;\n  pointer-events: none !important;\n  width: 0 !important;\n  height: 0 !important;\n  position: absolute !important;\n  left: -9999px !important;\n  top: -9999px !important;\n}\nhtml,\nbody {\n\tmargin: 0;\n\tpadding: 0;\n}\n",
