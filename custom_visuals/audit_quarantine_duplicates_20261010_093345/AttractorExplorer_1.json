mbiar, guardamos y actualizamos\n  if (frameCount % 30 == 0) {\n    guardarYContinuar();\n  } else { \n    Dibuja(); \n  }\n}\n\nfunction guardarYContinuar() {\n  // 1. Generamos el nombre con la info actual\n  let nombreArchivo = `dejong[${currentIndex}]_a${a}_b${b}_c${c}_d${d}.png`;\n  \n  // 2. Guardamos lo que hay en pantalla\n  //saveCanvas(nombreArchivo);\n  \n  // 3. Saltamos al siguiente y actualizamos parámetros\n  currentIndex++;\n  actualizarParametros();\n}\n\nfunction Dibuja(){\n  loadPixels();\n  for (let i = 0; i < 100000; i++) {\n    let nextX = sin(a * y) + c * cos(a * x);\n    let nextY = sin(b * x) + d * cos(b * y);\n    x = nextX;\n    y = nextY;\n\n    let px = floor(width / 2 + x * 150);\n    let py = floor(height / 2 + y * 150);\n\n    if (px >= 0 && px < width && py >= 0 && py < height) {\n      let index = (px + py * width) * 4;\n      if (pixels[index] < 255) {\n        pixels[index] += 15;\n        pixels[index + 1] += 15;\n        pixels[index + 2] += 15;\n      }\n      pixels[index + 3] = 255;\n    }\n  }\n  updatePixels();\n}\n\n// Mantenemos mousePressed por si quieres forzar el guardado manualmente\nfunction mousePressed() {\n  guardarYContinuar();\n}\n\nfunction actualizarParametros() {\n  background(0);\n  x = 0.1;\n  y = 0.1;\n\n  if (currentIndex < params.length) {\n    var p = params[currentIndex];\n    a = p.a; b = p.b; c = p.c; d = p.d;\n    //console.log(`Cargado set: ${currentIndex} -> a:${a}, b:${b}`);\n  } else {\n    // Si terminas la lista, se detiene para no saturar de descargas aleatorias\n    //console.log(\"Fin de la lista de parámetros.\");\n    noLoop();\n  }\n}\n\n",
