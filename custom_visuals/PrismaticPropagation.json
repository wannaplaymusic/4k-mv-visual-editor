    "code": "// === Tab: mySketch.js ===\nfunction setup() {\n\tcreateCanvas(windowWidth, windowHeight);\n\tbackground(100);\n}\n\nfunction draw() {\n\tcircle((window.simulatedMouseX !== undefined ? window.simulatedMouseX : (typeof sub_bass !== 'undefined' ? map(sub_bass, 0, 1, width*0.1, width*0.9) : (typeof live_centroid !== 'undefined' ? map(live_centroid, 100, 4000, 0, width) : mouseX))), (window.simulatedMouseY !== undefined ? window.simulatedMouseY : (typeof percussive !== 'undefined' ? map(percussive, 0, 1, height, 0) : (typeof roughness !== 'undefined' ? map(roughness, 0, 1, height*0.2, height*0.8) : mouseY))), 20);\n}\n\n",
    "frequency": 50,
    "storyboard_weight": 50,
    "post_fx_intensity": 50,
    "custom_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.js\"></script>\n  <style>\n    body { margin: 0; padding: 0; background: #000; overflow: hidden; font-family: 'Segoe UI', sans-serif; }\n    #ui-container {\n      position: absolute; top: 10px; left: 10px; background: rgba(15, 15, 15, 0.96);\n      color: white; padding: 18px; border-radius: 10px; border: 1px solid #444;\n      width: 280px; transition: transform 0.4s; z-index: 100;\n    }\n    #ui-container.collapsed { transform: translateX(-310px); }\n    .control-group { margin-bottom: 12px; }\n    label { display: block; font-size: 10px; text-transform: uppercase; color: #FFF; margin-bottom: 4px; font-weight: bold; }\n    input[type=range] { width: 100%; height: 4px; cursor: pointer; accent-color: #00f0ff; }\n    #toggle-ui {\n      position: absolute; right: -40px; top: 0; background: #222; border: 1px solid #444;\n      color: white; cursor: pointer; width: 40px; height: 40px; border-radius: 0 8px 8px 0;\n    }\n    .btn-row { display: flex; gap: 5px; margin-top: 10px; }\n    button { \n      flex: 1; padding: 10px; font-weight: bold; cursor: pointer; border-radius: 4px; border: none; font-size: 10px;\n    }\n    #export { background: #fff; color: #000; }\n    #import-btn { background: #333; color: #fff; border: 1px solid #555; }\n    .val { float: right; color: #00f0ff; font-family: monospace; }\n    hr { border: 0; border-top: 1px solid #333; margin: 10px 0; }\n    #file-input { display: none; }\n  </style>\n</head>\n<body>\n\n<div id=\"ui-container\">\n  <button id=\"toggle-ui\">UI</button>\n  \n  <div class=\"control-group\">\n    <label>Forme <span id=\"v-shape\" class=\"val\">Cercle</span></label>\n    <input type=\"range\" id=\"shapeType\" min=\"0\" max=\"2\" step=\"1\" value=\"0\">\n  </div>\n\n  <div class=\"control-group\">\n    <label>Rotation (180°) <span id=\"v-rot\" class=\"val\">30</span></label>\n    <input type=\"range\" id=\"rot\" min=\"-180\" max=\"180\" value=\"30\">\n  </div>\n\n  <div class=\"control-group\">\n    <label>Taille Forme <span id=\"v-radius\" class=\"val\">400</span></label>\n    <input type=\"range\" id=\"radius\" min=\"50\" max=\"800\" value=\"400\">\n  </div>\n\n  <hr>\n\n  <div class=\"control-group\">\n    <label>Lignes <span id=\"v-count\" class=\"val\">10</span></label>\n    <input type=\"range\" id=\"count\" min=\"1\" max=\"1000\" value=\"10\">\n  </div>\n\n  <div class=\"control-group\">\n    <label>Ligne Gap <span id=\"v-spacing\" class=\"val\">25</span></label>\n    <input type=\"range\" id=\"spacing\" min=\"0\" max=\"100\" value=\"25\">\n  </div>\n  \n  <div class=\"control-group\">\n    <label>Épaisseur <span id=\"v-width\" class=\"val\">10</span></label>\n    <input type=\"range\" id=\"width\" min=\"2\" max=\"30\" value=\"10\">\n  </div>\n\n  <div class=\"control-group\">\n    <label>Vitesse <span id=\"v-speed\" class=\"val\">0.01</span></label>\n    <input type=\"range\" id=\"speed\" min=\"0.001\" max=\"0.05\" step=\"0.001\" value=\"0.01\">\n  </div>\n\n  <div class=\"control-group\">\n    <label>Longueur Train <span id=\"v-trail\" class=\"val\">0.15</span></label>\n    <input type=\"range\" id=\"trail\" min=\"0.01\" max=\"0.6\" step=\"0.01\" value=\"0.15\">\n  </div>\n\n  <div class=\"btn-row\">\n    <button id=\"export\">EXPORT JSON</button>\n    <button id=\"import-btn\">IMPORT JSON</button>\n  </div>\n  <input type=\"file\" id=\"file-input\" accept=\".json\">\n</div>\n\n<script>\nlet particles = [];\nlet params = { \n  shapeType: 0, count: 10, thickness: 10, diameter: 400, \n  currentAngle: 30, speed: 0.01, trail: 0.15, spacing: 25 \n};\nconst SHAPES = [\"Cercle\", \"Carré\", \"Triangle\"];\n\nfunction setup() {\n  createCanvas(windowWidth, windowHeight);\n  colorMode(HSB, 360, 100, 100, 1);\n  initParticles();\n  \n  const ui = document.getElementById('ui-container');\n  document.getElementById('toggle-ui').onclick = () => ui.classList.toggle('collapsed');\n  \n  // Setup Sliders\n  setupSlider('shapeType', 'v-shape', 'shapeType', false, (v) => SHAPES[v]);\n  setupSlider('count', 'v-count', 'count', true);\n  setupSlider('width', 'v-width', 'thickness');\n  setupSlider('radius', 'v-radius', 'diameter');\n  setupSlider('rot', 'v-rot', 'currentAngle');\n  setupSlider('speed', 'v-speed', 'speed');\n  setupSlider('trail', 'v-trail', 'trail');\n  setupSlider('spacing', 'v-spacing', 'spacing');\n  \n  // Export/Import Logic\n  document.getElementById('export').onclick = () => saveJSON(params, 'optics_config.json');\n  \n  const fileInput = document.getElementById('file-input');\n  document.getElementById('import-btn').onclick = () => fileInput.click();\n  fileInput.onchange = (e) => {\n    const file = e.target.files[0];\n    if (!file) return;\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      const imported = JSON.parse(event.target.result);\n      Object.assign(params, imported);\n      updateUI();\n      initParticles();\n    };\n    reader.readAsText(file);\n  };\n}\n\nfunction updateUI() {\n  const keys = {\n    'shapeType': 'v-shape', 'count': 'v-count', 'thickness': 'v-width', \n    'diameter': 'v-radius', 'currentAngle': 'v-rot', 'speed': 'v-speed', \n    'trail': 'v-trail', 'spacing': 'v-spacing'\n  };\n  for (let key in keys) {\n    const input = document.getElementById(key === 'thickness' ? 'width' : (key === 'currentAngle' ? 'rot' : (key === 'diameter' ? 'radius' : key)));\n    if (input) {\n      input.value = params[key];\n      let valDisplay = SHAPES[params[key]] || params[key];\n      document.getElementById(keys[key]).innerText = valDisplay;\n    }\n  }\n}\n\nfunction initParticles() {\n  particles = [];\n  for (let i = 0; i < params.count; i++) {\n    particles.push({ progress: random(0, 1), speedMult: random(0.8, 1.2), hue: random(0, 360) });\n  }\n}\n\nfunction setupSlider(id, valId, key, reinit = false, displayFn = (v) => v) {\n  const s = document.getElementById(id);\n  s.oninput = () => {\n    params[key] = parseFloat(s.value);\n    document.getElementById(valId).innerText = displayFn(params[key]);\n    if (reinit) initParticles();\n  };\n}\n\nfunction draw() {\n  background(0);\n  let cx = width / 2, cy = height / 2, r = params.diameter / 2, a = radians(params.currentAngle);\n  let totalH = (params.count - 1) * params.spacing;\n  let startY = cy - totalH / 2;\n\n  for (let i = 0; i < particles.length; i++) {\n    let p = particles[i];\n    let y = startY + (i * params.spacing);\n    let path = calculatePath(y, cx, cy, r, a);\n    p.progress = (p.progress + params.speed * p.speedMult) % 1.0;\n    stroke(0, 0, 10);\n    strokeWeight(params.thickness);\n    noFill();\n    drawPath(path);\n    drawGlowingTrail(path, p.progress, p.hue);\n  }\n}\n\nfunction calculatePath(y, cx, cy, r, a) {\n  let dy = y - cy;\n  let dx = 0;\n  if (params.shapeType == 0) { // Cercle\n    if (abs(dy) < r) dx = sqrt(max(0, r * r - dy * dy));\n  } else if (params.shapeType == 1) { // Carré\n    if (abs(dy) < r) dx = r;\n  } else if (params.shapeType == 2) { // Triangle\n    let h = r * 2;\n    let relativeY = y - (cy - r); \n    if (relativeY > 0 && relativeY < h) dx = (relativeY / h) * r;\n  }\n  if (dx > 0) {\n    let cosA = cos(a), sinA = sin(a);\n    return [\n      {x: 0, y: y}, {x: cx - dx, y: y},\n      {x: cx + (-dx * cosA - dy * sinA), y: cy + (-dx * sinA + dy * cosA)},\n      {x: cx + (dx * cosA - dy * sinA), y: cy + (dx * sinA + dy * cosA)},\n      {x: cx + dx, y: y}, {x: width, y: y}\n    ];\n  }\n  return [{x: 0, y: y}, {x: width, y: y}];\n}\n\nfunction drawPath(p) {\n  beginShape();\n  for (let v of p) vertex(v.x, v.y);\n  endShape();\n}\n\nfunction drawGlowingTrail(path, progress, baseHue) {\n  let steps = 15; \n  for (let i = 0; i < steps; i++) {\n    let localProg = progress - (i / steps) * params.trail;\n    if (localProg < 0) localProg += 1.0;\n    let pos = getPointOnPath(path, localProg % 1.0);\n    let alpha = map(i, 0, steps, 1, 0);\n    let hue = (baseHue + frameCount * 0.5) % 360;\n    stroke(hue, 80, 100, alpha);\n    strokeWeight(params.thickness);\n    point(pos.x, pos.y);\n  }\n}\n\nfunction getPointOnPath(path, t) {\n  if (path.length < 2) return path[0];\n  let totalDist = 0;\n  for (let i = 0; i < path.length - 1; i++) totalDist += dist(path[i].x, path[i].y, path[i+1].x, path[i+1].y);\n  let targetDist = t * totalDist;\n  let currentDist = 0;\n  for (let i = 0; i < path.length - 1; i++) {\n    let d = dist(path[i].x, path[i].y, path[i+1].x, path[i+1].y);\n    if (currentDist + d >= targetDist) return { x: lerp(path[i].x, path[i+1].x, (targetDist - currentDist) / d), y: lerp(path[i].y, path[i+1].y, (targetDist - currentDist) / d) };\n    currentDist += d;\n  }\n  return path[path.length - 1];\n}\n\nfunction windowResized() { resizeCanvas(windowWidth, windowHeight); }\n</script>\n</body>\n</html>\n",
    "custom_css": "\n/* === 4K MV Pure Canvas - 全域控制項與 UI 面板極限無痕隱藏 === */\n.dg, .lil-gui, .qs_main, .opc-control, #opc-control-panel, .control-panel, .gui-container,\n.tp-dfwv, .tp-rotv, .tweakpane, [class*='tp-'], [class*='tweakpane'],\n[class*='gui'], [id*='gui'], [class*='control'], [id*='control'],\n[class*='instruction'], [id*='instruction'], [class*='info'], [id*='info'],\n[class*='fps'], [id*='fps'], [class*='overlay'], [id*='overlay'],\n[class*='panel'], [id*='panel'], [class*='toolbar'], [id*='toolbar'],\n.p5-control, .ui-container, #ui, #controls, .hud, [class*='hud'],\ninput, button, select, textarea, label, form, nav, header {\n  display: none !important;\n  visibility: hidden !important;\n  opacity: 0 !important;\n  pointer-events: none !important;\n  width: 0 !important;\n  height: 0 !important;\n  position: absolute !important;\n  left: -9999px !important;\n  top: -9999px !important;\n}\nhtml,\nbody {\n\tmargin: 0;\n\tpadding: 0;\n}\n",
