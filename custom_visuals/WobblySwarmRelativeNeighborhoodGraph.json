{
    "name": "WobblySwarmRelativeNeighborhoodGraph",
    "code": "// === Tab: mySketch ===\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// A fork of Wobbly Swarm by Konstantin Makhmutov\n// https://openprocessing.org/sketch/492096\n/////////////////////////////////////////////////////////////////////////////////////////////////////\nconst num=256 // maximum number of points\nlet balls=[]\n/////////////////////////////////////////////////////////////////////////////////////////////////////\nfunction setup() {\n  createCanvas(windowWidth, windowHeight)\n// set linedash pattern for lines\n  drawingContext.setLineDash([10,5,2,5])\n}\n/////////////////////////////////////////////////////////////////////////////////////////////////////\nfunction draw() {\n  background(32)\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// calcurate the velocity of each ball\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n  const infulence=map(sin(frameCount/60),-1,1,.96,1)  \n  for(const A of balls){\n    const acceleration=createVector(0,0)\n    for(const B of balls){\n      if (A !== B) {\n        const difference=p5.Vector.sub(B.position,A.position)\n        const distance = max(1,sqrt(difference.x **2 + difference.y **2))\n        const force = (distance - 320) * B.mass / distance\n        acceleration.add(difference.mult(force))\n      }\n    }    \n    A.velocity=A.velocity.mult(infulence).add(acceleration.mult(A.mass))\n  }\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// calcurate the position of each ball\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n  for (const A of balls) {\n    A.position.add(A.velocity)\n  }\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// draw lines  \n// reference: https://en.wikipedia.org/wiki/Relative_neighborhood_graph\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n  strokeWeight(1)\n  stroke(\"white\")\n  for(let i=balls.length;i--;){\n    const A=balls[i].position\n    for(let j=i;j--;){\n      const B=balls[j].position\n      let d=(A.x-B.x)**2+(A.y-B.y)**2\n      for(let k=balls.length;k--;){\n        const C=balls[k].position\n        if((C.x-A.x)**2+(C.y-A.y)**2<d&&(C.x-B.x)**2+(C.y-B.y)**2<d){d=0;break}\n      }\n      if(d>0)line(A.x,A.y,B.x,B.y)\n    }\n  }\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// draw balls\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n  noStroke()\n  for (const A of balls) {\n    const r=map(A.mass,.003,.03,255,0)\n    fill(r,r*2,255)\n    ellipse(A.position.x, A.position.y, A.mass * 1000);\n  }\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// \n/////////////////////////////////////////////////////////////////////////////////////////////////////  \n  if(balls.length<2){\n    textAlign(CENTER)\n    stroke(\"red\")\n    strokeWeight(9)\n    fill(\"white\")\n    text(\"Click and Drag the mouse\",width/2,height-20)\n  }\n}\n/////////////////////////////////////////////////////////////////////////////////////////////////////\n// functions\n/////////////////////////////////////////////////////////////////////////////////////////////////////  \nfunction addNewParticle() {\n  if(balls.length>=num){\n    balls.shift()\n  }\n  balls.push({\n    mass:random(0.003, 0.03),\n    position:createVector((window.simulatedMouseX !== undefined ? window.simulatedMouseX : (typeof sub_bass !== 'undefined' ? map(sub_bass, 0, 1, width*0.1, width*0.9) : (typeof live_centroid !== 'undefined' ? map(live_centroid, 100, 4000, 0, width) : mouseX))),(window.simulatedMouseY !== undefined ? window.simulatedMouseY : (typeof percussive !== 'undefined' ? map(percussive, 0, 1, height, 0) : (typeof roughness !== 'undefined' ? map(roughness, 0, 1, height*0.2, height*0.8) : mouseY)))),\n    velocity:createVector()\n  })\n}\n/////////////////////////////////////////////////////////////////////////////////////////////////////\nfunction mouseClicked() {\n  addNewParticle()\n}\n/////////////////////////////////////////////////////////////////////////////////////////////////////\nfunction mouseDragged() {\n  addNewParticle()\n}\n\n",
    "frequency": 50,
    "storyboard_weight": 50,
